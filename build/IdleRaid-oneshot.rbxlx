          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[local GrowthConfig = require(script.Parent.GrowthConfig)

local GameConfig = {
	Player = {
		InitialGold = 0,
		InitialBaseAttack = 10,
		InitialBaseDefense = 0,
		InitialMaxHealth = 100,
	},
	Level = {
		AttackIncreasePerLevel = 2,
	},
	Combat = {
