  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local EnemyService = require(script.Parent.EnemyService)
local InventoryService = require(script.Parent.InventoryService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RaidService = require(script.Parent.RaidService)

local CombatService = {}
local lastAttackAt = {}
local rewardRandom = Random.new()
local visualRemote: RemoteEvent?

local function grantKillRewards(player: Player, enemyId: string)
	local definition = GameConfig.Enemies[enemyId]
	if not definition then
		warn(string.format("[IdleRaid] Missing rewards for EnemyId %s", enemyId))
		return
	end

	local profile = PlayerDataService.GetProfile(player)
	if not profile or not definition.ZoneId then return end
	local power = GrowthMath.EnemyPower(profile.BreakthroughStage, definition.ZoneId)
	if power then PlayerDataService.AddPowerFinal(player, power, "EnemyKill") end
	PlayerDataService.AddGold(player, rewardRandom:NextInteger(definition.GoldMin, definition.GoldMax), "EnemyKill")
	for _, drop in ipairs(definition.DropTable) do
		if typeof(drop.Chance) == "number" and drop.Chance >= 0 and drop.Chance <= 1 then
			if rewardRandom:NextNumber() < drop.Chance then
				InventoryService.AddItem(player, drop.ItemId, 1)
			end
		else
			warn(string.format("[IdleRaid] Invalid drop chance for %s", tostring(drop.ItemId)))
		end
	end
end

local function onAttackRequested(player: Player, target: any)
	if typeof(target) ~= "Instance" or not target:IsA("Model") then
		return
	end

	if not EnemyService.IsAliveEnemy(target) or not RaidService.CanAttack(player, target) then
		return
	end
	local profile = PlayerDataService.GetProfile(player)
	local requiredStage = EnemyService.GetRequiredStage(target)
	if not profile or not requiredStage or profile.BreakthroughStage < requiredStage then return end

	local targetPosition = EnemyService.GetAttackPosition(target)
	if not targetPosition then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end

	if (root.Position - targetPosition).Magnitude > GameConfig.Combat.AttackRange then
		return
	end

	local now = os.clock()
	if now - (lastAttackAt[player] or -math.huge) < GameConfig.Combat.AttackCooldown then
		return
	end

	local attack = PlayerDataService.GetFinalAttack(player)
	if not attack then
		return
	end

	local isBoss = target:GetAttribute("IsBoss") == true
	local dealt, killed, enemyId = EnemyService.ApplyDamage(target, attack)
	if dealt <= 0 then
		return
	end

	lastAttackAt[player] = now
	if visualRemote then
		visualRemote:FireAllClients(player, enemyId, targetPosition, dealt, killed)
	end
	print(string.format("[IdleRaid] %s dealt %d damage to %s", player.Name, dealt, enemyId))
	if isBoss then
		RaidService.OnBossDamaged(player, target, dealt, killed)
	elseif killed then
		print(string.format("[IdleRaid] %s killed %s", player.Name, enemyId))
		grantKillRewards(player, enemyId)
	end
end

function CombatService.Start()
	local remoteFolder = ReplicatedStorage:FindFirstChild("IdleRaidRemotes")
	if not remoteFolder then
		remoteFolder = Instance.new("Folder")
		remoteFolder.Name = "IdleRaidRemotes"
		remoteFolder.Parent = ReplicatedStorage
	end

	local attackRemote = remoteFolder:FindFirstChild("BasicAttack")
	if not attackRemote then
		attackRemote = Instance.new("RemoteEvent")
		attackRemote.Name = "BasicAttack"
		attackRemote.Parent = remoteFolder
	end

	visualRemote = Instance.new("RemoteEvent")
	visualRemote.Name = "CombatVisual"
	visualRemote.Parent = remoteFolder

	attackRemote.OnServerEvent:Connect(onAttackRequested)
	Players.PlayerRemoving:Connect(function(player)
		lastAttackAt[player] = nil
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">EnemyAppearance</string>
          <string name="Source"><![CDATA[local EnemyAppearance = {}

local function part(model: Model, body: BasePart, name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material)
	local piece = Instance.new("Part")
	piece.Name = name
	piece.Shape = Enum.PartType.Ball
	piece.Size = size
	piece.Color = color
	piece.Material = material
	piece.Anchored = false
	piece.Massless = true
	piece.CanCollide = false
	piece.CanTouch = false
	piece.CanQuery = false
	piece.CFrame = body.CFrame * CFrame.new(offset)
	piece.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = piece
	weld.Parent = piece
end

local function nameplate(model: Model, body: BasePart, definition, isBoss: boolean)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Nameplate"
	gui.Adornee = body
	gui.AlwaysOnTop = true
	gui.MaxDistance = if isBoss then 100 else 55
	gui.Size = UDim2.fromOffset(if isBoss then 180 else 120, 42)
	gui.StudsOffsetWorldSpace = Vector3.new(0, body.Size.Y / 2 + 1.2, 0)
	gui.Parent = model
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 24)
	title.Font = Enum.Font.GothamBold
	title.TextSize = if isBoss then 18 else 14
	title.TextStrokeTransparency = 0.35
	title.TextColor3 = if isBoss then Color3.fromRGB(255, 222, 117) else Color3.fromRGB(255, 255, 255)
	title.Text = string.format("Lv.%d  %s", definition.Level, definition.Name or definition.Id)
	title.Parent = gui
	local track = Instance.new("Frame")
	track.Name = "HealthTrack"
	track.BorderSizePixel = 0
	track.BackgroundColor3 = Color3.fromRGB(22, 32, 45)
	track.Position = UDim2.new(0, 4, 0, 27)
	track.Size = UDim2.new(1, -8, 0, 8)
	track.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = track
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = if isBoss then Color3.fromRGB(255, 105, 113) else Color3.fromRGB(119, 238, 151)
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
end

function EnemyAppearance.Apply(model: Model, body: BasePart, definition)
	local isBoss = definition.IsBoss == true
	local scale = if isBoss then 2.3 else 1
	body.Material = Enum.Material.SmoothPlastic
	body.Color = if isBoss then Color3.fromRGB(84, 127, 238) else Color3.fromRGB(91, 215, 137)
	local white = Color3.fromRGB(248, 252, 255)
	local ink = Color3.fromRGB(25, 41, 65)
	for _, sign in ipairs({ -1, 1 }) do
		part(model, body, if sign < 0 then "LeftEye" else "RightEye",
			Vector3.new(0.4, 0.53, 0.2) * scale,
			Vector3.new(sign * 0.55, 0.27, -1.35) * scale, white, Enum.Material.SmoothPlastic)
		part(model, body, if sign < 0 then "LeftPupil" else "RightPupil",
			Vector3.new(0.2, 0.3, 0.12) * scale,
			Vector3.new(sign * 0.55, 0.24, -1.49) * scale, ink, Enum.Material.SmoothPlastic)
		part(model, body, if sign < 0 then "LeftCheek" else "RightCheek",
			Vector3.new(0.31, 0.14, 0.12) * scale,
			Vector3.new(sign * 0.98, -0.28, -1.15) * scale,
			Color3.fromRGB(250, 145, 170), Enum.Material.SmoothPlastic)
	end
	part(model, body, "Smile", Vector3.new(0.52, 0.12, 0.12) * scale,
		Vector3.new(0, -0.37, -1.43) * scale, ink, Enum.Material.SmoothPlastic)
	if isBoss then
		local gold = Color3.fromRGB(255, 204, 75)
		part(model, body, "CrownBand", Vector3.new(4.9, 0.42, 4.9), Vector3.new(0, 3.43, 0), gold, Enum.Material.Metal)
		for index, x in ipairs({ -1.55, 0, 1.55 }) do
			part(model, body, "CrownPoint" .. index, Vector3.new(0.8, if index == 2 then 1.35 else 1, 0.8),
				Vector3.new(x, 4.03, -1.1), gold, Enum.Material.Metal)
		end
		part(model, body, "CrownGem", Vector3.new(0.55, 0.65, 0.2),
			Vector3.new(0, 3.48, -2.42), Color3.fromRGB(255, 88, 129), Enum.Material.Neon)
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "VisualHighlight"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.OutlineColor = if isBoss then Color3.fromRGB(255, 204, 92) else Color3.fromRGB(45, 119, 92)
	highlight.OutlineTransparency = if isBoss then 0.1 else 0.32
	highlight.FillTransparency = 1
	highlight.Parent = model
	nameplate(model, body, definition, isBoss)
end

return EnemyAppearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local EnemyAppearance = require(script.Parent.EnemyAppearance)

local EnemyService = {}

local enemies = {}
local activeBySpawn = {}
local respawnPending = {}
local started = false
local enemyFolder: Folder?

local function getSpawnLayout(): (Vector3, Vector3)
	local playerSpawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if playerSpawn then
		local center = playerSpawn.Position
			+ playerSpawn.CFrame.LookVector * GameConfig.EnemySpawns.DistanceFromPlayerSpawn
		return center, playerSpawn.CFrame.RightVector
	end

	return Vector3.new(0, 0, -GameConfig.EnemySpawns.DistanceFromPlayerSpawn), Vector3.new(1, 0, 0)
end

local function getSpawnPoints(folder: Folder): { BasePart }
	local points = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			table.insert(points, child)
		end
	end

	local center, right = getSpawnLayout()
	local count = GameConfig.EnemySpawns.DefaultCount
	if #points == 0 then
	for index = 1, count do
		local point = Instance.new("Part")
		point.Name = string.format("SpawnPoint%d", index)
		point.Size = Vector3.new(2, 0.2, 2)
		point.Color = Color3.fromRGB(85, 170, 105)
		point.Transparency = 0.7
		point.Anchored = true
		point.CanCollide = false
		point.CanTouch = false
		point.CanQuery = false
		point.Position = center
			+ right * ((index - (count + 1) / 2) * GameConfig.EnemySpawns.Spacing)
			+ Vector3.new(0, 0.2, 0)
		point:SetAttribute("EnemyId", GameConfig.EnemySpawns.DefaultEnemyId)
		point.Parent = folder
		table.insert(points, point)
	end
	end

	local playerSpawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local forward = if playerSpawn then playerSpawn.CFrame.LookVector else Vector3.new(0, 0, -1)
	for zoneIndex = 2, #GrowthConfig.Zones do
		local zone = GrowthConfig.Zones[zoneIndex]
		local hasZone = false
		for _, point in ipairs(points) do
			if point:GetAttribute("EnemyId") == zone.EnemyId then hasZone = true; break end
		end
		if not hasZone then
			local zoneCenter = center + forward * ((zoneIndex - 1) * 24)
			for index = 1, zone.Count do
				local point = Instance.new("Part")
				point.Name = string.format("Generated_%s_%d", zone.Id, index)
				point.Size = Vector3.new(2, 0.2, 2)
				point.Transparency = 0.8
				point.Anchored = true
				point.CanCollide = false
				point.CanTouch = false
				point.CanQuery = false
				point.Position = zoneCenter + right * ((index - (zone.Count + 1) / 2) * 7) + Vector3.new(0, 0.2, 0)
				point:SetAttribute("EnemyId", zone.EnemyId)
				point.Parent = folder
				table.insert(points, point)
			end
		end
	end
	return points
end

local function makeEnemyModel(definition, spawnPoint: BasePart): Model
	local model = Instance.new("Model")
	model.Name = definition.Id

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = definition.Size or Vector3.new(3, 3, 3)
	body.Color = definition.Color or Color3.fromRGB(85, 205, 105)
	body.Anchored = true
	body.CanCollide = true
	local position = spawnPoint.Position + Vector3.new(0, spawnPoint.Size.Y / 2 + body.Size.Y / 2, 0)
	local playerSpawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local lookAt = if definition.IsBoss then GameConfig.Raid.ArenaCenter + Vector3.new(0, 0, -20)
		elseif playerSpawn then playerSpawn.Position else position + Vector3.new(0, 0, 1)
	local facing = Vector3.new(lookAt.X, position.Y, lookAt.Z)
	body.CFrame = if (facing - position).Magnitude > 0.1 then CFrame.lookAt(position, facing) else CFrame.new(position)
	body.Parent = model
	model.PrimaryPart = body
	EnemyAppearance.Apply(model, body, definition)

	return model
end

function EnemyService.RegisterEnemy(model: Model, spawnPoint: BasePart, enemyId: string, options): boolean
	local definition = GameConfig.Enemies[enemyId]
	if not enemyFolder or not definition or not model.PrimaryPart or enemies[model] or activeBySpawn[spawnPoint] then
		return false
	end

	enemies[model] = {
		Id = enemyId,
		RequiredStage = definition.RequiredStage or 1,
		Health = (options and options.MaxHealth) or definition.MaxHealth,
		MaxHealth = (options and options.MaxHealth) or definition.MaxHealth,
		NoRespawn = options and options.NoRespawn or false,
		Definition = definition,
		SpawnPoint = spawnPoint,
		Alive = true,
	}
	activeBySpawn[spawnPoint] = model
	model:SetAttribute("EnemyId", enemyId)
	model:SetAttribute("RequiredStage", definition.RequiredStage or 1)
	model:SetAttribute("Health", enemies[model].Health)
	model:SetAttribute("MaxHealth", enemies[model].MaxHealth)
	model:SetAttribute("IsBoss", definition.IsBoss == true)
	model:SetAttribute("Attack", definition.Attack)
	model:SetAttribute("Level", definition.Level)
	model.Parent = enemyFolder
	print(string.format("[IdleRaid] %s spawned at %s", enemyId, spawnPoint.Name))
	return true
end

function EnemyService.SpawnAt(spawnPoint: BasePart, enemyId: string, options): Model?
	local definition = GameConfig.Enemies[enemyId]
	if not definition or activeBySpawn[spawnPoint] then return nil end
	local model = makeEnemyModel(definition, spawnPoint)
	if not EnemyService.RegisterEnemy(model, spawnPoint, enemyId, options) then
		model:Destroy()
		return nil
	end
	return model
end

local function spawnAt(spawnPoint: BasePart)
	if activeBySpawn[spawnPoint] or not spawnPoint:IsDescendantOf(Workspace) then
		return
	end

	local enemyId = spawnPoint:GetAttribute("EnemyId")
	if typeof(enemyId) ~= "string" or enemyId == "" then
		enemyId = GameConfig.EnemySpawns.DefaultEnemyId
	end

	local definition = GameConfig.Enemies[enemyId]
	if not definition then
		warn(string.format("[IdleRaid] Unknown EnemyId %s on %s", enemyId, spawnPoint.Name))
		return
	end

	EnemyService.SpawnAt(spawnPoint, enemyId)
end

function EnemyService.Start()
	if started then
		return
	end

	local folder = Workspace:FindFirstChild("EnemySpawns")
	if folder and not folder:IsA("Folder") then
		warn("[IdleRaid] Workspace.EnemySpawns must be a Folder")
		return
	end
	local existingEnemies = Workspace:FindFirstChild("Enemies")
	if existingEnemies and not existingEnemies:IsA("Folder") then
		warn("[IdleRaid] Workspace.Enemies must be a Folder")
		return
	end

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "EnemySpawns"
		folder.Parent = Workspace
	end
	if not existingEnemies then
		existingEnemies = Instance.new("Folder")
		existingEnemies.Name = "Enemies"
		existingEnemies.Parent = Workspace
	end
	enemyFolder = existingEnemies
	started = true

	for _, spawnPoint in ipairs(getSpawnPoints(folder)) do
		spawnAt(spawnPoint)
	end
end

function EnemyService.IsAliveEnemy(target: Instance): boolean
	if not target:IsA("Model") then
		return false
	end

	local state = enemies[target]
	return state ~= nil and state.Alive and state.Health > 0 and target.Parent == enemyFolder
end

function EnemyService.GetRequiredStage(target: Instance): number?
	local state = enemies[target]
	return state and state.RequiredStage or nil
end

function EnemyService.GetAttackPosition(target: Instance): Vector3?
	if not EnemyService.IsAliveEnemy(target) then
		return nil
	end

	local body = (target :: Model).PrimaryPart
	return body and body.Position or nil
end

function EnemyService.GetHealthSnapshot(target: Instance)
	if not EnemyService.IsAliveEnemy(target) then return nil end
	local state = enemies[target]
	return { Health = state.Health, MaxHealth = state.MaxHealth, Id = state.Id }
end

function EnemyService.RemoveEnemy(target: Instance)
	local state = enemies[target]
	if not state then return end
	enemies[target] = nil
	activeBySpawn[state.SpawnPoint] = nil
	target:Destroy()
end


function EnemyService.ApplyDamage(target: Instance, damage: number): (number, boolean, string?)
	if not EnemyService.IsAliveEnemy(target) or damage <= 0 then
		return 0, false, nil
	end

	local state = enemies[target]
	local dealt = math.min(damage, state.Health)
	state.Health -= dealt
	target:SetAttribute("Health", state.Health)

	if state.Health > 0 then
		return dealt, false, state.Id
	end

	state.Alive = false
	enemies[target] = nil
	activeBySpawn[state.SpawnPoint] = nil
	target:Destroy()

	local spawnPoint = state.SpawnPoint
	if not state.NoRespawn and not respawnPending[spawnPoint] then
		respawnPending[spawnPoint] = true
		task.delay(state.Definition.RespawnTime, function()
			respawnPending[spawnPoint] = nil
			spawnAt(spawnPoint)
		end)
	end

	return dealt, true, state.Id
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">EquipmentService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local InventoryService = require(script.Parent.InventoryService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local ProfileStore = require(script.Parent.ProfileStore)

local EquipmentService = {}
local validSlots = { Weapon = true, Armor = true, Accessory = true }

function EquipmentService.GetSnapshot(player: Player)
	local profile = ProfileStore.Get(player)
	if not profile then return nil end
	return {
		Weapon = profile.Equipment.Weapon,
		Armor = profile.Equipment.Armor,
		Accessory = profile.Equipment.Accessory,
	}
end

function EquipmentService.EquipItem(player: Player, itemId: any): boolean
	if typeof(itemId) ~= "string" then return false end
	local definition = ItemConfig.Items[itemId]
	if not definition or definition.Id ~= itemId or not validSlots[definition.Type] then return false end
	if InventoryService.GetQuantity(player, itemId) < 1 then return false end
	local profile = ProfileStore.Get(player)
	if not profile then return false end
	local slot = definition.Type
	if profile.Equipment[slot] == itemId then return true end
	profile.Equipment[slot] = itemId
	PlayerDataService.RecalculateStats(player, { Kind = "Equipment", Action = "Equip", ItemId = itemId, Slot = slot })
	print(string.format("[IdleRaid] %s equipped %s (%s)", player.Name, definition.Name, slot))
	return true
end

function EquipmentService.Unequip(player: Player, slot: any): boolean
	if typeof(slot) ~= "string" or not validSlots[slot] then return false end
	local profile = ProfileStore.Get(player)
	if not profile or not profile.Equipment[slot] then return false end
	profile.Equipment[slot] = nil
	PlayerDataService.RecalculateStats(player, { Kind = "Equipment", Action = "Unequip", Slot = slot })
	return true
end

function EquipmentService.Start()
	local remoteFolder = ReplicatedStorage:FindFirstChild("IdleRaidRemotes")
	if not remoteFolder then
		remoteFolder = Instance.new("Folder")
		remoteFolder.Name = "IdleRaidRemotes"
		remoteFolder.Parent = ReplicatedStorage
	end
	local equipRemote = Instance.new("RemoteEvent")
	equipRemote.Name = "EquipItem"
	equipRemote.Parent = remoteFolder
	equipRemote.OnServerEvent:Connect(function(player, itemId) EquipmentService.EquipItem(player, itemId) end)
	local unequipRemote = Instance.new("RemoteEvent")
	unequipRemote.Name = "UnequipEquipment"
	unequipRemote.Parent = remoteFolder
	unequipRemote.OnServerEvent:Connect(function(player, slot) EquipmentService.Unequip(player, slot) end)
end

return EquipmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">GrowthService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local SafeInteger = require(ReplicatedStorage.Shared.SafeInteger)
local PlayerDataService = require(script.Parent.PlayerDataService)
local ProfileStore = require(script.Parent.ProfileStore)
local TrainingService = require(script.Parent.TrainingService)
local StateSyncService = require(script.Parent.StateSyncService)

local GrowthService = {}
local raidBusyCheck = function(_player) return false end
local busy = {}
local requestCache = {}
local lastRemoteAt = {}

local function failed(reason: string, extra)
	return { Ok = false, Reason = reason, Preview = extra }
end

local function validRequestId(value: any): boolean
	return typeof(value) == "string" and #value >= 8 and #value <= 64
end

local function inRaid(player: Player): boolean
	return raidBusyCheck(player)
end

function GrowthService.SetRaidBusyCheck(callback)
	raidBusyCheck = callback
end

function GrowthService.PreviewBreakthrough(player: Player, steps: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if not SafeInteger.IsValid(steps) or (steps ~= 1 and steps ~= 2 and steps ~= 3 and steps ~= 5) then
		return failed("InvalidStep")
	end
	local stage = profile.BreakthroughStage
	local allowed, gateReason = GrowthMath.CanAdvance(stage, steps, profile.ClearedRaidGates)
	local cost = if stage < GrowthConfig.MaxStage then GrowthMath.BreakthroughCost(stage) else 0
	local reason = if ProfileStore.IsReceiptPending(player) then "ReceiptSaving"
		elseif inRaid(player) then "RaidInProgress" elseif not allowed then gateReason
		elseif steps > 1 and (profile.BreakthroughTickets[tostring(steps)] or 0) < 1 then "NoTicket"
		elseif profile.AvailableTrainingPower < cost then "InsufficientPower" else nil
	return {
		Ok = reason == nil,
		Reason = reason,
		Stage = stage,
		TargetStage = if allowed then stage + steps else nil,
		Cost = cost,
		AvailablePower = profile.AvailableTrainingPower,
		Tickets = if steps > 1 then profile.BreakthroughTickets[tostring(steps)] or 0 else nil,
		CurrentMultiplier = GrowthMath.StageMultiplier(stage),
		TargetMultiplier = if allowed then GrowthMath.StageMultiplier(stage + steps) else nil,
		CurrentRate = GrowthMath.BaseRate(stage, profile.TrainingFacilityTier),
		TargetRate = if allowed then GrowthMath.BaseRate(stage + steps, profile.TrainingFacilityTier) else nil,
		NextGate = GrowthMath.NextGate(stage, profile.ClearedRaidGates),
	}
end

function GrowthService.TryBreakthrough(player: Player, steps: any, expectedStage: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if not SafeInteger.IsValid(expectedStage) or profile.BreakthroughStage ~= expectedStage then
		return failed("StalePreview", GrowthService.PreviewBreakthrough(player, steps))
	end
	if ProfileStore.IsReceiptPending(player) then return failed("ReceiptSaving") end
	if inRaid(player) then return failed("RaidInProgress") end
	TrainingService.Settle(player)
	local preview = GrowthService.PreviewBreakthrough(player, steps)
	if not preview.Ok then return failed(preview.Reason, preview) end
	local cost = preview.Cost
	local remaining = SafeInteger.Subtract(profile.AvailableTrainingPower, cost)
	if not remaining then return failed("InsufficientPower", preview) end
	local key = tostring(steps)
	if steps > 1 then
		if profile.BreakthroughTickets[key] < 1 then return failed("NoTicket", preview) end
		profile.BreakthroughTickets[key] -= 1
	end
	profile.AvailableTrainingPower = remaining
	profile.BreakthroughStage += steps
	PlayerDataService.AfterGrowthChange(player, nil, {
		Kind = "Breakthrough", Steps = steps, From = preview.Stage,
		To = profile.BreakthroughStage, BeforeRate = preview.CurrentRate,
		AfterRate = preview.TargetRate, Cost = cost,
	})
	return { Ok = true, Stage = profile.BreakthroughStage, Cost = cost }
end

function GrowthService.TryUpgradeFacility(player: Player, expectedTier: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if not SafeInteger.IsValid(expectedTier) or expectedTier ~= profile.TrainingFacilityTier then
		return failed("StalePreview")
	end
	if ProfileStore.IsReceiptPending(player) then return failed("ReceiptSaving") end
	if inRaid(player) then return failed("RaidInProgress") end
	local beforeRate = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier)
	local nextFacility = GrowthConfig.Facilities[profile.TrainingFacilityTier + 1]
	if not nextFacility then return failed("MaxFacility") end
	if nextFacility.RequiredGate and not profile.ClearedRaidGates[nextFacility.RequiredGate] then
		return failed("GateRequired")
	end
	TrainingService.Settle(player)
	if profile.Gold < nextFacility.GoldCost then return failed("InsufficientGold") end
	profile.Gold -= nextFacility.GoldCost
	profile.TrainingFacilityTier += 1
	PlayerDataService.AfterGrowthChange(player, nil, {
		Kind = "Facility", Tier = profile.TrainingFacilityTier,
		BeforeRate = beforeRate,
		AfterRate = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier),
		GoldSpent = nextFacility.GoldCost,
	})
	return { Ok = true, Tier = profile.TrainingFacilityTier }
end

function GrowthService.PreviewVoucher(player: Player, voucherId: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if typeof(voucherId) ~= "string" then return failed("InvalidVoucher") end
	local voucher = GrowthConfig.Vouchers[voucherId]
	if not voucher then return failed("InvalidVoucher") end
	local rate = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier)
	local grant = SafeInteger.Multiply(rate, voucher.Seconds)
	if not grant then return failed("PowerCap") end
	return {
		Ok = (profile.TrainingVouchers[voucherId] or 0) > 0 and not inRaid(player),
		Reason = if inRaid(player) then "RaidInProgress"
			elseif (profile.TrainingVouchers[voucherId] or 0) < 1 then "NoVoucher" else nil,
		VoucherId = voucherId, Count = profile.TrainingVouchers[voucherId] or 0,
		Rate = rate, Grant = grant, Stage = profile.BreakthroughStage,
		FacilityTier = profile.TrainingFacilityTier,
	}
end

function GrowthService.TryUseVoucher(player: Player, voucherId: any, expectedRate: any, expectedCount: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if ProfileStore.IsReceiptPending(player) then return failed("ReceiptSaving") end
	if inRaid(player) then return failed("RaidInProgress") end
	TrainingService.Settle(player)
	local preview = GrowthService.PreviewVoucher(player, voucherId)
	if expectedRate ~= preview.Rate or expectedCount ~= preview.Count then
		return failed("StalePreview", preview)
	end
	if not preview.Ok then return failed(preview.Reason, preview) end
	local available = SafeInteger.Add(profile.AvailableTrainingPower, preview.Grant)
	local lifetime = SafeInteger.Add(profile.LifetimeTrainingPower, preview.Grant)
	if not available or not lifetime then return failed("PowerCap", preview) end
	local oldLifetime = profile.LifetimeTrainingPower
	profile.TrainingVouchers[voucherId] -= 1
	profile.AvailableTrainingPower = available
	profile.LifetimeTrainingPower = lifetime
	PlayerDataService.AfterGrowthChange(player, oldLifetime, { Kind = "Voucher", Amount = preview.Grant })
	return { Ok = true, GrantedPower = preview.Grant }
end

function GrowthService.TryExchangeTicket(player: Player, steps: any, expectedTokens: any, expectedCount: any)
	local profile = ProfileStore.Get(player)
	if not profile then return failed("ProfileNotReady") end
	if ProfileStore.IsReceiptPending(player) then return failed("ReceiptSaving") end
	if inRaid(player) then return failed("RaidInProgress") end
	if not SafeInteger.IsValid(steps) or not GrowthConfig.TokenTicketCost[steps] then return failed("InvalidStep") end
	local key = tostring(steps)
	if expectedTokens ~= profile.RaidToken or expectedCount ~= profile.BreakthroughTickets[key] then
		return failed("StalePreview")
	end
	local cost = GrowthConfig.TokenTicketCost[steps]
	if profile.RaidToken < cost then return failed("InsufficientToken") end
	local nextCount = SafeInteger.Add(profile.BreakthroughTickets[key], 1)
	if not nextCount then return failed("TicketCap") end
	profile.RaidToken -= cost
	profile.BreakthroughTickets[key] = nextCount
	PlayerDataService.AfterGrowthChange(player, nil, { Kind = "TokenExchange", Steps = steps })
	return { Ok = true, TokensSpent = cost, Tickets = nextCount }
end

function GrowthService.GrantOwnership(player: Player, kind: string, value: any, count: number): boolean
	local profile = ProfileStore.Get(player)
	if not profile or not SafeInteger.IsValid(count) or count < 1 then return false end
	local bucket, key
	if kind == "Ticket" and SafeInteger.IsValid(value) and GrowthConfig.TokenTicketCost[value] then
		bucket, key = profile.BreakthroughTickets, tostring(value)
	elseif kind == "Voucher" and typeof(value) == "string" and GrowthConfig.Vouchers[value] then
		bucket, key = profile.TrainingVouchers, value
	else return false end
	local nextCount = SafeInteger.Add(bucket[key] or 0, count)
	if not nextCount then return false end
	bucket[key] = nextCount
	PlayerDataService.AfterGrowthChange(player, nil, { Kind = "Ownership", Item = key, Count = count })
	return true
end

function GrowthService.CanClearGate(player: Player, gateId: string): boolean
	local profile = ProfileStore.Get(player)
	if not profile then return false end
	for _, gate in ipairs(GrowthConfig.Gates) do
		if gate.Id == gateId then
			if profile.BreakthroughStage < gate.Stage then return false end
			return true
		end
		if not profile.ClearedRaidGates[gate.Id] then return false end
	end
	return false
end

function GrowthService.RecordGateClear(player: Player, gateId: string): boolean
	local profile = ProfileStore.Get(player)
	if not profile or profile.ClearedRaidGates[gateId] or not GrowthService.CanClearGate(player, gateId) then
		return false
	end
	profile.ClearedRaidGates[gateId] = true
	PlayerDataService.AfterGrowthChange(player, nil, { Kind = "GateClear", GateId = gateId })
	return true
end

local function callAction(player: Player, action: any, payload: any)
	if typeof(action) ~= "string" or typeof(payload) ~= "table" then return failed("InvalidRequest") end
	if action == "PreviewBreakthrough" then return GrowthService.PreviewBreakthrough(player, payload.Steps) end
	if action == "PreviewVoucher" then return GrowthService.PreviewVoucher(player, payload.VoucherId) end
	local requestId = payload.RequestId
	if not validRequestId(requestId) then return failed("InvalidRequestId") end
	local cache = requestCache[player]
	if not cache then cache = { Results = {}, Order = {} } requestCache[player] = cache end
	local previous = cache.Results[requestId]
	if previous then return if previous.Action == action then previous.Result else failed("RequestIdReused") end
	if busy[player] then return failed("Busy") end
	busy[player] = true
	local ok, result = pcall(function()
		if action == "Breakthrough" then return GrowthService.TryBreakthrough(player, payload.Steps, payload.ExpectedStage)
		elseif action == "UpgradeFacility" then return GrowthService.TryUpgradeFacility(player, payload.ExpectedTier)
		elseif action == "UseVoucher" then return GrowthService.TryUseVoucher(player, payload.VoucherId, payload.ExpectedRate, payload.ExpectedCount)
		elseif action == "ExchangeTicket" then return GrowthService.TryExchangeTicket(player, payload.Steps, payload.ExpectedTokens, payload.ExpectedCount)
		else return failed("UnknownAction") end
	end)
	busy[player] = nil
	if not ok then
		warn("[IdleRaid] Growth request failed: " .. tostring(result))
		return failed("ServerError")
	end
	cache.Results[requestId] = { Action = action, Result = result }
	table.insert(cache.Order, requestId)
	if #cache.Order > 128 then cache.Results[table.remove(cache.Order, 1)] = nil end
	return result
end

local function handleRemote(player, action, payload)
	if typeof(payload) == "table" and typeof(payload.RequestId) == "string" then
		local cache = requestCache[player]
		local previous = cache and cache.Results[payload.RequestId]
		if previous then return if previous.Action == action then previous.Result else failed("RequestIdReused") end
	end
	local now = os.clock()
	if now - (lastRemoteAt[player] or -math.huge) < 0.05 then return failed("RateLimited") end
	lastRemoteAt[player] = now
	return callAction(player, action, payload)
end

function GrowthService.Start()
	local folder = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local remote = Instance.new("RemoteFunction")
	remote.Name = "GrowthAction"
	remote.Parent = folder
	remote.OnServerInvoke = handleRemote
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		busy[player] = nil
		requestCache[player] = nil
		lastRemoteAt[player] = nil
	end)
	if RunService:IsStudio() then
		GrowthService.TestHandleRemote = handleRemote
		local debugGrant = Instance.new("RemoteFunction")
		debugGrant.Name = "StudioGrowthGrant"
		debugGrant.Parent = folder
		debugGrant.OnServerInvoke = function(player, kind, value)
			if not ProfileStore.IsStudioSandbox(player) then return false end
			if kind == "Power" and SafeInteger.IsValid(value) and value > 0 then
				return PlayerDataService.AddPowerFinal(player, value, "StudioTest")
			elseif kind == "Gold" and SafeInteger.IsValid(value) and value > 0 then
				return PlayerDataService.AddGold(player, value)
			elseif kind == "Ticket" then
				return GrowthService.GrantOwnership(player, "Ticket", value, 1)
			elseif kind == "Voucher" then
				return GrowthService.GrantOwnership(player, "Voucher", value, 1)
			end
			return false
		end
	end
end

return GrowthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local SafeInteger = require(ReplicatedStorage.Shared.SafeInteger)
local ProfileStore = require(script.Parent.ProfileStore)
local StateSyncService = require(script.Parent.StateSyncService)

local InventoryService = {}

function InventoryService.Start() end

function InventoryService.AddItem(player: Player, itemId: any, quantity: any): boolean
	if typeof(itemId) ~= "string" then return false end
	local definition = ItemConfig.Items[itemId]
	if not definition or definition.Id ~= itemId then
		warn(string.format("[IdleRaid] Unknown ItemId: %s", tostring(itemId)))
		return false
	end
	if not SafeInteger.IsValid(quantity) or quantity < 1 then return false end
	local profile = ProfileStore.Get(player)
	if not profile then return false end
	local nextQuantity = SafeInteger.Add(profile.Inventory[itemId] or 0, quantity)
	if not nextQuantity then return false end
	profile.Inventory[itemId] = nextQuantity
	ProfileStore.Touch(player)
	StateSyncService.Push(player, { Kind = "Item", ItemId = itemId, Quantity = quantity })
	print(string.format("[IdleRaid] %s obtained %s x%d", player.Name, definition.Name, nextQuantity))
	return true
end

function InventoryService.GetQuantity(player: Player, itemId: string): number
	local profile = ProfileStore.Get(player)
	return if profile then profile.Inventory[itemId] or 0 else 0
end

function InventoryService.GetSnapshot(player: Player): { { ItemId: string, Quantity: number } }
	local snapshot = {}
	local profile = ProfileStore.Get(player)
	if not profile then return snapshot end
	for itemId, quantity in pairs(profile.Inventory) do
		table.insert(snapshot, { ItemId = itemId, Quantity = quantity })
	end
	table.sort(snapshot, function(a, b) return a.ItemId < b.ItemId end)
	return snapshot
end

function InventoryService.PrintInventory(player: Player)
	local entries = {}
	for _, stack in ipairs(InventoryService.GetSnapshot(player)) do
		table.insert(entries, string.format("%s x%d", stack.ItemId, stack.Quantity))
	end
	print(string.format("[IdleRaid] Inventory %s: %s", player.Name,
		if #entries > 0 then table.concat(entries, ", ") else "(empty)"))
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">LevelService</string>
          <string name="Source"><![CDATA[local GrowthMath = require(game:GetService("ReplicatedStorage").Shared.GrowthMath)
local LevelService = {}

function LevelService.GetExpRequired(level: number): number
	local current = GrowthMath.LifetimeForLevel(level)
	local nextThreshold = GrowthMath.LifetimeForLevel(level + 1)
	return if current and nextThreshold then nextThreshold - current else 0
end

return LevelService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local ProfileStore = require(script.Parent.ProfileStore)
local PlayerDataService = require(script.Parent.PlayerDataService)
local InventoryService = require(script.Parent.InventoryService)
local EquipmentService = require(script.Parent.EquipmentService)
local EnemyService = require(script.Parent.EnemyService)
local WorldVisualService = require(script.Parent.WorldVisualService)
local CombatService = require(script.Parent.CombatService)
local RaidService = require(script.Parent.RaidService)
local GrowthService = require(script.Parent.GrowthService)
local TrainingService = require(script.Parent.TrainingService)
local MonetizationService = require(script.Parent.MonetizationService)
local StateSyncService = require(script.Parent.StateSyncService)

PlayerDataService.Start()
InventoryService.Start()
EquipmentService.Start()
WorldVisualService.EnsureSpawn()
EnemyService.Start()
RaidService.Start()
GrowthService.SetRaidBusyCheck(function(player)
	local raid = RaidService.GetSnapshot(player)
	return raid and raid.IsParticipant == true or false
end)
GrowthService.Start()
TrainingService.Start()
MonetizationService.Start()
WorldVisualService.Start(RaidService.Join)
CombatService.Start()

local function getPlayerState(player: Player, kind: string?)
	local state = PlayerDataService.GetSnapshot(player)
	if not state then return nil end
	if kind == "Growth" or not state.Ready then return state end
	state.Inventory = InventoryService.GetSnapshot(player)
	state.Equipment = EquipmentService.GetSnapshot(player)
	state.Raid = RaidService.GetSnapshot(player)
	state.OfflineSummary = ProfileStore.GetOfflineSummary(player)
	return state
end

StateSyncService.Start(getPlayerState)

if RunService:IsStudio() then
	local debugState = Instance.new("BindableFunction")
	debugState.Name = "DebugGetPlayerState"
	debugState.OnInvoke = function(player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then return nil end
		return getPlayerState(player, "Full")
	end
	debugState.Parent = script.Parent

	local debugGrant = Instance.new("BindableFunction")
	debugGrant.Name = "DebugGrantItem"
	debugGrant.OnInvoke = function(player, itemId, quantity)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then return false end
		return InventoryService.AddItem(player, itemId, quantity)
	end
	debugGrant.Parent = script.Parent

	local modeRemote = Instance.new("RemoteFunction")
	modeRemote.Name = "StudioProfileMode"
	modeRemote.OnServerInvoke = function(player, enabled)
		if typeof(enabled) ~= "boolean" then return false end
		if RaidService.GetSnapshot(player).IsParticipant then return false end
		TrainingService.Settle(player)
		local switched = ProfileStore.SetStudioSandbox(player, enabled)
		if switched then
			TrainingService.ResetClock(player)
			PlayerDataService.RefreshProfile(player)
		end
		return switched
	end
	modeRemote.Parent = game:GetService("ReplicatedStorage"):WaitForChild("IdleRaidRemotes")

	local debugItemRemote = Instance.new("RemoteFunction")
	debugItemRemote.Name = "StudioInventoryGrant"
	debugItemRemote.OnServerInvoke = function(player, itemId)
		if not ProfileStore.IsStudioSandbox(player) then return false end
		return InventoryService.AddItem(player, itemId, 1)
	end
	debugItemRemote.Parent = game:GetService("ReplicatedStorage"):WaitForChild("IdleRaidRemotes")
end

print("[IdleRaid] Server Started")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local SafeInteger = require(ReplicatedStorage.Shared.SafeInteger)
local GrowthService = require(script.Parent.GrowthService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local ProfileStore = require(script.Parent.ProfileStore)

local MonetizationService = {}
local byProductId = {}
local receiptBusy = {}

local function contractForId(productId: any)
	if not SafeInteger.IsValid(productId) or productId < 1 then return nil, nil end
	return byProductId[productId]
end

local function grantFixedOwnership(profile, productKey: string, contract): boolean
	local bucket, key
	if contract.Kind == "Ticket" then
		bucket, key = profile.BreakthroughTickets, tostring(contract.Value)
	elseif contract.Kind == "Voucher" then
		bucket, key = profile.TrainingVouchers, contract.Value
	else return false end
	local nextCount = SafeInteger.Add(bucket[key] or 0, 1)
	if not nextCount then return false end
	bucket[key] = nextCount
	return true
end

function MonetizationService.ProcessSynthetic(player: Player, purchaseId: string, productKey: string)
	if typeof(purchaseId) ~= "string" or #purchaseId < 1 or #purchaseId > 128 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local contract = GrowthConfig.Products[productKey]
	if not contract or contract.ContractVersion ~= 1 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = ProfileStore.Get(player)
	if not profile then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if receiptBusy[player] then return Enum.ProductPurchaseDecision.NotProcessedYet end
	receiptBusy[player] = true
	ProfileStore.SetReceiptPending(player, true)
	local recorded = profile.ProcessedPurchases[purchaseId]
	local expectedRecord = productKey .. ":v" .. tostring(contract.ContractVersion)
	if recorded and recorded ~= expectedRecord then
		receiptBusy[player] = nil
		ProfileStore.SetReceiptPending(player, false)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not recorded then
		if not grantFixedOwnership(profile, productKey, contract) then
			receiptBusy[player] = nil
			ProfileStore.SetReceiptPending(player, false)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		profile.ProcessedPurchases[purchaseId] = expectedRecord
		PlayerDataService.AfterGrowthChange(player, nil, { Kind = "Ownership", Item = productKey, Count = 1 })
	end
	local saved = ProfileStore.SaveReceipt(player, purchaseId)
	receiptBusy[player] = nil
	if saved then
		ProfileStore.SetReceiptPending(player, false)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receiptInfo)
	if typeof(receiptInfo) ~= "table" then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local productKey = contractForId(receiptInfo.ProductId)
	if not productKey or typeof(receiptInfo.PurchaseId) ~= "string" then
		warn("[IdleRaid] Unconfigured product receipt retained for retry")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not SafeInteger.IsValid(receiptInfo.PlayerId) or receiptInfo.PlayerId < 1 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
	return MonetizationService.ProcessSynthetic(player, receiptInfo.PurchaseId, productKey)
end

function MonetizationService.Start()
	for productKey, contract in pairs(GrowthConfig.Products) do
		local productId = contract.ProductId
		if productId ~= nil then
			assert(SafeInteger.IsValid(productId) and productId > 0 and not byProductId[productId],
				"Invalid or duplicate developer ProductId")
			byProductId[productId] = productKey
		end
	end
	-- A valid earlier receipt is processed even when new purchase prompts are disabled.
	MarketplaceService.ProcessReceipt = processReceipt
	Players.PlayerRemoving:Connect(function(player) receiptBusy[player] = nil end)
	if RunService:IsStudio() then
		local debugReceipt = Instance.new("BindableFunction")
		debugReceipt.Name = "DebugProcessSyntheticReceipt"
		debugReceipt.OnInvoke = function(player, purchaseId, productKey)
			if typeof(player) ~= "Instance" or not player:IsA("Player") then return nil end
			return MonetizationService.ProcessSynthetic(player, purchaseId, productKey)
		end
		debugReceipt.Parent = script.Parent
		local debugRemote = Instance.new("RemoteFunction")
		debugRemote.Name = "StudioSyntheticReceipt"
		debugRemote.Parent = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
		debugRemote.OnServerInvoke = function(player, purchaseId, productKey)
			if not ProfileStore.IsStudioSandbox(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
			return MonetizationService.ProcessSynthetic(player, purchaseId, productKey)
		end
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PlayerDataService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local SafeInteger = require(ReplicatedStorage.Shared.SafeInteger)
local ProfileStore = require(script.Parent.ProfileStore)
local StatService = require(script.Parent.StatService)
local StateSyncService = require(script.Parent.StateSyncService)

local PlayerDataService = {}
local runtime = {}

local function makeStat(parent: Instance, name: string, value: number)
	local stat = Instance.new("IntValue")
	stat.Name = name
	stat.Value = value
	stat.Parent = parent
end

local function recalculate(player: Player)
	local profile = ProfileStore.Get(player)
	local data = runtime[player]
	if not profile or not data then return end
	local level = GrowthMath.LevelProgress(profile.LifetimeTrainingPower)
	local attackBonus, defenseBonus = StatService.GetEquipmentBonuses(profile.Equipment)
	data.FinalAttack, data.FinalDefense = StatService.Calculate({
		Level = level,
		BaseAttack = GameConfig.Player.InitialBaseAttack,
		BaseDefense = GameConfig.Player.InitialBaseDefense,
		EquipmentAttackBonus = attackBonus,
		EquipmentDefenseBonus = defenseBonus,
	})
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local _, exp = GrowthMath.LevelProgress(profile.LifetimeTrainingPower)
		for name, value in pairs({ Level = level, Exp = exp, Gold = profile.Gold,
			Attack = data.FinalAttack, Defense = data.FinalDefense }) do
			local stat = leaderstats:FindFirstChild(name)
			if stat then stat.Value = value end
		end
	end
end

local function onProfileReady(player: Player, ready: boolean)
	if not ready then StateSyncService.Push(player) return end
	runtime[player] = {
		MaxHealth = GameConfig.Player.InitialMaxHealth,
		Health = GameConfig.Player.InitialMaxHealth,
	}
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		for _, name in ipairs({ "Level", "Exp", "Gold", "Attack", "Defense" }) do
			makeStat(leaderstats, name, 0)
		end
		leaderstats.Parent = player
	end
	recalculate(player)
	StateSyncService.Push(player)
end

function PlayerDataService.Start()
	ProfileStore.Start(onProfileReady)
	Players.PlayerRemoving:Connect(function(player) runtime[player] = nil end)
end

function PlayerDataService.RefreshProfile(player: Player)
	if not ProfileStore.Get(player) then return end
	recalculate(player)
	StateSyncService.Push(player)
end

function PlayerDataService.GetProfile(player: Player)
	return ProfileStore.Get(player)
end

function PlayerDataService.IsReady(player: Player): boolean
	return ProfileStore.Get(player) ~= nil
end

function PlayerDataService.GetGrowthSnapshot(player: Player)
	local profile = ProfileStore.Get(player)
	if not profile then return { Ready = false, LoadStatus = ProfileStore.GetStatus(player), StateRevision = 0 } end
	local data = runtime[player]
	local level, exp, required = GrowthMath.LevelProgress(profile.LifetimeTrainingPower)
	local multiplier = GrowthMath.StageMultiplier(profile.BreakthroughStage)
	return {
		Ready = true,
		StudioSandbox = ProfileStore.IsStudioSandbox(player),
		StateRevision = profile.StateRevision,
		Level = level,
		Exp = exp,
		ExpRequired = required,
		Gold = profile.Gold,
		RaidToken = profile.RaidToken,
		BaseAttack = GameConfig.Player.InitialBaseAttack,
		FinalAttack = data and data.FinalAttack or 0,
		BaseDefense = GameConfig.Player.InitialBaseDefense,
		FinalDefense = data and data.FinalDefense or 0,
		Health = data and data.Health or 0,
		MaxHealth = data and data.MaxHealth or GameConfig.Player.InitialMaxHealth,
		AvailableTrainingPower = profile.AvailableTrainingPower,
		LifetimeTrainingPower = profile.LifetimeTrainingPower,
		BreakthroughStage = profile.BreakthroughStage,
		TrainingFacilityTier = profile.TrainingFacilityTier,
		TrainingEnabled = profile.TrainingEnabled,
		StageMultiplier = multiplier,
		BaseTrainingRate = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier),
		BreakthroughCost = if profile.BreakthroughStage < GrowthConfig.MaxStage
			then GrowthMath.BreakthroughCost(profile.BreakthroughStage) else nil,
		BreakthroughTickets = table.clone(profile.BreakthroughTickets),
		TrainingVouchers = table.clone(profile.TrainingVouchers),
		ClearedRaidGates = table.clone(profile.ClearedRaidGates),
	}
end

function PlayerDataService.GetSnapshot(player: Player)
	return PlayerDataService.GetGrowthSnapshot(player)
end

function PlayerDataService.GetFinalAttack(player: Player): number?
	local data = runtime[player]
	return if ProfileStore.Get(player) and data then data.FinalAttack else nil
end

function PlayerDataService.GetGold(player: Player): number?
	local profile = ProfileStore.Get(player)
	return profile and profile.Gold or nil
end

function PlayerDataService.GetHealth(player: Player): number?
	local data = runtime[player]
	return if ProfileStore.Get(player) and data then data.Health else nil
end

function PlayerDataService.RecalculateStats(player: Player, notification)
	if not ProfileStore.Get(player) then return end
	ProfileStore.Touch(player)
	recalculate(player)
	StateSyncService.Push(player, notification)
end

function PlayerDataService.AfterGrowthChange(player: Player, oldLifetime: number?, notification)
	local profile = ProfileStore.Get(player)
	if not profile then return end
	ProfileStore.Touch(player)
	recalculate(player)
	StateSyncService.PushGrowth(player, notification)
	if oldLifetime then
		local oldLevel = GrowthMath.LevelProgress(oldLifetime)
		local newLevel = GrowthMath.LevelProgress(profile.LifetimeTrainingPower)
		for level = oldLevel + 1, newLevel do
			print(string.format("[IdleRaid] %s reached Level %d", player.Name, level))
		end
	end
end

function PlayerDataService.AddPowerFinal(player: Player, amount: number, source: string?): boolean
	local profile = ProfileStore.Get(player)
	if not profile or not SafeInteger.IsValid(amount) or amount < 1 then return false end
	local available = SafeInteger.Add(profile.AvailableTrainingPower, amount)
	local lifetime = SafeInteger.Add(profile.LifetimeTrainingPower, amount)
	if not available or not lifetime then return false end
	local oldLifetime = profile.LifetimeTrainingPower
	profile.AvailableTrainingPower = available
	profile.LifetimeTrainingPower = lifetime
	PlayerDataService.AfterGrowthChange(player, oldLifetime,
		{ Kind = "Power", Amount = amount, Source = source or "Reward" })
	if source and source ~= "OnlineTraining" then
		print(string.format("[IdleRaid] %s gained %d Training Power from %s", player.Name, amount, source))
	end
	return true
end

-- Legacy server callers receive a final award, never an extra stage/facility multiplier.
function PlayerDataService.AddExp(player: Player, amount: number)
	return PlayerDataService.AddPowerFinal(player, amount, "LegacyReward")
end

function PlayerDataService.AddGold(player: Player, amount: number, source: string?): boolean
	local profile = ProfileStore.Get(player)
	if not profile or not SafeInteger.IsValid(amount) or amount < 1 then return false end
	local nextGold = SafeInteger.Add(profile.Gold, amount)
	if not nextGold then return false end
	profile.Gold = nextGold
	PlayerDataService.AfterGrowthChange(player, nil, { Kind = "Gold", Amount = amount, Source = source or "Reward" })
	return true
end

function PlayerDataService.SpendGold(player: Player, amount: number): boolean
	local profile = ProfileStore.Get(player)
	if not profile or not SafeInteger.IsValid(amount) or amount < 1 or amount > profile.Gold then return false end
	profile.Gold -= amount
	PlayerDataService.AfterGrowthChange(player)
	return true
end

function PlayerDataService.AddRaidToken(player: Player, amount: number): boolean
	local profile = ProfileStore.Get(player)
	if not profile or not SafeInteger.IsValid(amount) or amount < 1 then return false end
	local nextToken = SafeInteger.Add(profile.RaidToken, amount)
	if not nextToken then return false end
	profile.RaidToken = nextToken
	PlayerDataService.AfterGrowthChange(player)
	return true
end

function PlayerDataService.ResetRaidHealth(player: Player): boolean
	local data = runtime[player]
	if not data or not ProfileStore.Get(player) then return false end
	data.Health = data.MaxHealth
	PlayerDataService.AfterGrowthChange(player)
	return true
end

function PlayerDataService.ApplyRaidDamage(player: Player, amount: number): number?
	local data = runtime[player]
	if not data or not ProfileStore.Get(player) or not SafeInteger.IsValid(amount) or amount < 1 then return nil end
	data.Health = math.max(0, data.Health - amount)
	PlayerDataService.AfterGrowthChange(player)
	return data.Health
end

-- Kept for compatibility with equipment calls; final bonuses are derived from the unified profile.
function PlayerDataService.SetEquipmentBonuses(player: Player, _attack: number, _defense: number): boolean
	if not ProfileStore.Get(player) then return false end
	PlayerDataService.RecalculateStats(player)
	return true
end

return PlayerDataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage.Shared
local GrowthConfig = require(shared.GrowthConfig)
local GrowthMath = require(shared.GrowthMath)
local SafeInteger = require(shared.SafeInteger)
local ItemConfig = require(shared.ItemConfig)

local ProfileSchema = {}
local slots = { "Weapon", "Armor", "Accessory" }

local function copyCounts(raw, keys): ({ [string]: number }?, string?)
	if raw == nil then raw = {} end
	if typeof(raw) ~= "table" then return nil, "InvalidCounts" end
	local result = {}
	for _, key in ipairs(keys) do
		local value = raw[key] or 0
		if not SafeInteger.IsValid(value) then return nil, "InvalidCount_" .. key end
		result[key] = value
	end
	return result, nil
end

local function inventory(raw): ({ [string]: number }?, string?)
	if raw == nil then return {}, nil end
	if typeof(raw) ~= "table" then return nil, "InvalidInventory" end
	local result = {}
	for key, entry in pairs(raw) do
		local itemId, quantity
		if typeof(key) == "number" and typeof(entry) == "table" then
			itemId, quantity = entry.ItemId, entry.Quantity
		else
			itemId, quantity = key, entry
		end
		if typeof(itemId) ~= "string" or not ItemConfig.Items[itemId]
			or not SafeInteger.IsValid(quantity) or quantity < 1 then return nil, "InvalidInventoryEntry" end
		local nextQuantity = SafeInteger.Add(result[itemId] or 0, quantity)
		if not nextQuantity then return nil, "InventoryOverflow" end
		result[itemId] = nextQuantity
	end
	return result, nil
end

local function equipment(raw, owned): ({ [string]: string }?, string?)
	if raw == nil then return {}, nil end
	if typeof(raw) ~= "table" then return nil, "InvalidEquipment" end
	local result = {}
	for _, slot in ipairs(slots) do
		local itemId = raw[slot]
		if itemId ~= nil then
			local definition = typeof(itemId) == "string" and ItemConfig.Items[itemId]
			if not definition or definition.Type ~= slot or not owned[itemId] then
				return nil, "InvalidEquipment_" .. slot
			end
			result[slot] = itemId
		end
	end
	return result, nil
end

local function gates(raw): ({ [string]: boolean }?, string?)
	if raw == nil then return {}, nil end
	if typeof(raw) ~= "table" then return nil, "InvalidGates" end
	local result = {}
	for _, gate in ipairs(GrowthConfig.Gates) do
		local value = raw[gate.Id]
		if value ~= nil and typeof(value) ~= "boolean" then return nil, "InvalidGate_" .. gate.Id end
		if value == true then result[gate.Id] = true end
	end
	return result, nil
end

local function receipts(raw): ({ [string]: string }?, string?)
	if raw == nil then return {}, nil end
	if typeof(raw) ~= "table" then return nil, "InvalidReceipts" end
	local result = {}
	for purchaseId, productKey in pairs(raw) do
		if typeof(purchaseId) ~= "string" or #purchaseId < 1 or #purchaseId > 128
			or typeof(productKey) ~= "string" or #productKey > 64 then return nil, "InvalidReceipt" end
		result[purchaseId] = productKey
	end
	return result, nil
end

function ProfileSchema.New(now: number)
	return {
		DataVersion = GrowthConfig.DataVersion,
		StateRevision = 0,
		AvailableTrainingPower = 0,
		LifetimeTrainingPower = 0,
		BreakthroughStage = 1,
		TrainingFacilityTier = 1,
		TrainingEnabled = true,
		ClearedRaidGates = {},
		Gold = 0,
		RaidToken = 0,
		Inventory = {},
		Equipment = {},
		BreakthroughTickets = { ["2"] = 0, ["3"] = 0, ["5"] = 0 },
		TrainingVouchers = { Minutes10 = 0, Minutes30 = 0, Minutes120 = 0 },
		ProcessedPurchases = {},
		LastSettlementUnix = now,
		OfflineRateSnapshot = GrowthMath.BaseRate(1, 1),
		TrainingRemainderMillis = 0,
	}
end

function ProfileSchema.Migrate(raw: any, now: number): (any, string?)
	if not SafeInteger.IsValid(now) then return nil, "InvalidServerTime" end
	if raw == nil then return ProfileSchema.New(now), nil end
	if typeof(raw) ~= "table" then return nil, "CorruptProfile" end
	local version = raw.DataVersion or 1
	if not SafeInteger.IsValid(version) or version > GrowthConfig.DataVersion or version < 1 then
		return nil, "UnsupportedDataVersion"
	end
	local profile = ProfileSchema.New(now)
	local owned, errorText = inventory(raw.Inventory)
	if not owned then return nil, errorText end
	profile.Inventory = owned
	local equipped
	equipped, errorText = equipment(raw.Equipment, owned)
	if not equipped then return nil, errorText end
	profile.Equipment = equipped
	for _, key in ipairs({ "Gold", "RaidToken" }) do
		local value = raw[key] or 0
		if not SafeInteger.IsValid(value) then return nil, "Invalid" .. key end
		profile[key] = value
	end
	local tickets
	tickets, errorText = copyCounts(raw.BreakthroughTickets, { "2", "3", "5" })
	if not tickets then return nil, errorText end
	profile.BreakthroughTickets = tickets
	local vouchers
	vouchers, errorText = copyCounts(raw.TrainingVouchers, { "Minutes10", "Minutes30", "Minutes120" })
	if not vouchers then return nil, errorText end
	profile.TrainingVouchers = vouchers
	local purchases
	purchases, errorText = receipts(raw.ProcessedPurchases)
	if not purchases then return nil, errorText end
	profile.ProcessedPurchases = purchases
	if version == 1 then
		local oldLevel = raw.Level or 1
		local oldExp = raw.Exp or 0
		local oldRequired = 100 + (oldLevel - 1) * 50
		if not SafeInteger.IsValid(oldLevel) or oldLevel < 1 or oldLevel > GrowthConfig.MaxLevel
			or not SafeInteger.IsValid(oldExp) or oldExp >= oldRequired then return nil, "InvalidLegacyLevel" end
		profile.LifetimeTrainingPower = GrowthMath.LifetimeForLevel(oldLevel, oldExp, oldRequired)
		profile.Migration = { FromVersion = 1, At = now }
		return profile, nil
	end
	for _, key in ipairs({ "AvailableTrainingPower", "LifetimeTrainingPower", "BreakthroughStage",
		"TrainingFacilityTier", "StateRevision", "LastSettlementUnix", "OfflineRateSnapshot", "TrainingRemainderMillis" }) do
		local value = raw[key]
		if not SafeInteger.IsValid(value) then return nil, "Invalid" .. key end
		profile[key] = value
	end
	if profile.AvailableTrainingPower > profile.LifetimeTrainingPower
		or profile.BreakthroughStage < 1 or profile.BreakthroughStage > GrowthConfig.MaxStage
		or not GrowthConfig.Facilities[profile.TrainingFacilityTier]
		or profile.TrainingRemainderMillis >= 1000 then return nil, "InvalidGrowthState" end
	if typeof(raw.TrainingEnabled) ~= "boolean" then return nil, "InvalidTrainingEnabled" end
	profile.TrainingEnabled = raw.TrainingEnabled
	local cleared
	cleared, errorText = gates(raw.ClearedRaidGates)
	if not cleared then return nil, errorText end
	profile.ClearedRaidGates = cleared
	if raw.Migration ~= nil then profile.Migration = raw.Migration end
	return profile, nil
end

return ProfileSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local GrowthConfig = require(game:GetService("ReplicatedStorage").Shared.GrowthConfig)
local GrowthMath = require(game:GetService("ReplicatedStorage").Shared.GrowthMath)
local SafeInteger = require(game:GetService("ReplicatedStorage").Shared.SafeInteger)
local ProfileSchema = require(script.Parent.ProfileSchema)

local ProfileStore = {}
local isMock = RunService:IsStudio()
local store = if isMock then nil else DataStoreService:GetDataStore("IdleRaid_Profile_v2")
local mockRecords = {}
local mockFailures = 0
local entries = {}
local onReady
local beforeSave
local sessionId = (game.JobId ~= "" and game.JobId or "Studio") .. ":" .. HttpService:GenerateGUID(false)
local MAX_JSON_BYTES = 3 * 1024 * 1024

local function clone(value)
	if typeof(value) ~= "table" then return value end
	local result = {}
	for key, child in pairs(value) do result[key] = clone(child) end
	return result
end

local function keyFor(player: Player, mode: string?): string
	local prefix = if mode == "Sandbox" then "StudioSandbox_Player_" else "Player_"
	return prefix .. tostring(player.UserId)
end

local function update(key: string, transformer)
	if isMock then
		if mockFailures > 0 then
			mockFailures -= 1
			error("MockUpdateFailure")
		end
		local old = clone(mockRecords[key])
		local nextRecord = transformer(old)
		if nextRecord ~= nil then mockRecords[key] = clone(nextRecord) end
		return clone(mockRecords[key])
	end
	return store:UpdateAsync(key, transformer)
end

local function tryUpdate(key: string, transformer): (boolean, any)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(update, key, transformer)
		if ok then return true, result end
		lastError = result
		if attempt < 3 then task.wait(0.35 * attempt) end
	end
	return false, lastError
end

local function offlineSettle(profile, now: number)
	local elapsed = math.max(0, now - profile.LastSettlementUnix)
	local accepted = math.min(elapsed, GrowthConfig.OfflineMaxSeconds)
	local oldLifetime = profile.LifetimeTrainingPower
	local oldRate = if profile.TrainingEnabled then profile.OfflineRateSnapshot else 0
	local grant = SafeInteger.MultiplyRatioFloor(oldRate,
		accepted * GrowthConfig.OfflineRateNumerator, GrowthConfig.OfflineRateDenominator)
	if not grant then return nil, "OfflineOverflow" end
	local available = SafeInteger.Add(profile.AvailableTrainingPower, grant)
	local lifetime = SafeInteger.Add(profile.LifetimeTrainingPower, grant)
	if not available or not lifetime then return nil, "PowerCap" end
	profile.AvailableTrainingPower = available
	profile.LifetimeTrainingPower = lifetime
	profile.LastSettlementUnix = now
	profile.OfflineRateSnapshot = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier)
	if grant > 0 then profile.StateRevision += 1 end
	local beforeLevel = GrowthMath.LevelProgress(oldLifetime)
	local afterLevel = GrowthMath.LevelProgress(lifetime)
	return {
		ElapsedSeconds = elapsed,
		AcceptedSeconds = accepted,
		Rate = oldRate,
		EfficiencyNumerator = GrowthConfig.OfflineRateNumerator,
		EfficiencyDenominator = GrowthConfig.OfflineRateDenominator,
		GrantedPower = grant,
		LevelBefore = beforeLevel,
		LevelAfter = afterLevel,
	}, nil
end

local function load(player: Player)
	local entry = { Status = "Loading", Saving = false, Mode = "Normal" }
	entries[player] = entry
	local now = os.time()
	local failure
	local offlineSummary
	local ok, record = tryUpdate(keyFor(player), function(raw)
		local lock = raw and raw._Session
		if lock and lock.Owner ~= sessionId and SafeInteger.IsValid(lock.ExpiresAt) and lock.ExpiresAt > now then
			failure = "SessionLocked"
			return nil
		end
		local profile, reason = ProfileSchema.Migrate(raw, now)
		if not profile then failure = reason return nil end
		local summary, settleReason = offlineSettle(profile, now)
		if not summary then failure = settleReason return nil end
		offlineSummary = summary
		profile._Session = { Owner = sessionId, ExpiresAt = now + GrowthConfig.SessionLeaseSeconds }
		return profile
	end)
	if entries[player] ~= entry or player.Parent ~= Players then return end
	if not ok or not record or not record._Session or record._Session.Owner ~= sessionId then
		entry.Status = failure or "LoadFailed"
		warn(string.format("[IdleRaid] Profile load blocked for %s: %s", player.Name, entry.Status))
		if onReady then onReady(player, false) end
		return
	end
	record._Session = nil
	entry.Profile = record
	entry.Status = "Ready"
	entry.OfflineSummary = offlineSummary
	entry.SavedRevision = record.StateRevision
	if onReady then onReady(player, true) end
end

function ProfileStore.Get(player: Player)
	local entry = entries[player]
	return if entry and entry.Status == "Ready" then entry.Profile else nil
end

function ProfileStore.GetStatus(player: Player): string
	local entry = entries[player]
	return if entry then entry.Status else "Loading"
end

function ProfileStore.IsStudioSandbox(player: Player): boolean
	local entry = entries[player]
	return isMock and entry ~= nil and entry.Status == "Ready" and entry.Mode == "Sandbox"
end

-- The normal profile is saved first. Development grants only touch a separate
-- Studio record that is never sent to the production DataStore.
function ProfileStore.SetStudioSandbox(player: Player, enabled: boolean): boolean
	if not isMock or typeof(enabled) ~= "boolean" then return false end
	local entry = entries[player]
	if not entry or entry.Status ~= "Ready" or entry.Saving then return false end
	if (entry.Mode == "Sandbox") == enabled then return true end
	local saved = ProfileStore.Save(player)
	if not saved then return false end
	if enabled then
		local now = os.time()
		local sandboxKey = keyFor(player, "Sandbox")
		local profile = ProfileSchema.Migrate(mockRecords[sandboxKey], now)
		if not profile then return false end
		local summary = offlineSettle(profile, now)
		if not summary then return false end
		profile._Session = { Owner = sessionId, ExpiresAt = now + GrowthConfig.SessionLeaseSeconds }
		mockRecords[sandboxKey] = clone(profile)
		profile._Session = nil
		entry.NormalProfile = entry.Profile
		entry.Profile = profile
		entry.Mode = "Sandbox"
	else
		if not entry.NormalProfile then return false end
		entry.Profile = entry.NormalProfile
		entry.NormalProfile = nil
		entry.Mode = "Normal"
	end
	entry.OfflineSummary = nil
	entry.SavedRevision = entry.Profile.StateRevision
	return true
end

function ProfileStore.GetOfflineSummary(player: Player)
	local entry = entries[player]
	return entry and entry.OfflineSummary or nil
end

function ProfileStore.SetReceiptPending(player: Player, pending: boolean)
	local entry = entries[player]
	if entry and entry.Status == "Ready" then entry.ReceiptPending = pending end
end

function ProfileStore.IsReceiptPending(player: Player): boolean
	local entry = entries[player]
	return entry ~= nil and entry.ReceiptPending == true
end

function ProfileStore.Touch(player: Player): boolean
	local profile = ProfileStore.Get(player)
	if not profile then return false end
	profile.StateRevision += 1
	return true
end

function ProfileStore.SetBeforeSave(callback)
	beforeSave = callback
end

function ProfileStore.Save(player: Player, release: boolean?): (boolean, string?)
	local entry = entries[player]
	if not entry or entry.Status ~= "Ready" then return false, "ProfileNotReady" end
	local deadline = os.clock() + 10
	while entry.Saving do
		if os.clock() > deadline then return false, "SaveBusy" end
		task.wait(0.05)
	end
	entry.Saving = true
	if beforeSave then
		local settled, result = pcall(beforeSave, player)
		if not settled or result == false then
			entry.Saving = false
			warn(string.format("[IdleRaid] Profile settlement failed for %s: %s", player.Name, tostring(result)))
			return false, "SettlementFailed"
		end
	end
	local profile = entry.Profile
	profile.LastSettlementUnix = os.time()
	profile.OfflineRateSnapshot = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier)
	local snapshot = clone(profile)
	local savedRevision = snapshot.StateRevision
	local failure
	local ok, record = tryUpdate(keyFor(player, entry.Mode), function(raw)
		if not raw or not raw._Session or raw._Session.Owner ~= sessionId then
			failure = "SessionLost"
			return nil
		end
		if (raw.StateRevision or 0) > savedRevision then
			failure = "StaleSnapshot"
			return nil
		end
		local nextRecord = clone(snapshot)
		if not release then
			nextRecord._Session = { Owner = sessionId, ExpiresAt = os.time() + GrowthConfig.SessionLeaseSeconds }
		end
		if #HttpService:JSONEncode(nextRecord) > MAX_JSON_BYTES then
			failure = "ProfileTooLarge"
			return nil
		end
		return nextRecord
	end)
	entry.Saving = false
	if not ok or not record or failure or (not release and (not record._Session or record._Session.Owner ~= sessionId)) then
		if failure == "SessionLost" then entry.Status = "SessionLost" end
		warn(string.format("[IdleRaid] Profile save failed for %s: %s", player.Name, tostring(failure or record)))
		return false, failure or "SaveFailed"
	end
	entry.SavedRevision = savedRevision
	if release then entries[player] = nil end
	return true, nil
end

function ProfileStore.SaveReceipt(player: Player, purchaseId: string): (boolean, string?)
	local profile = ProfileStore.Get(player)
	if not profile or not profile.ProcessedPurchases[purchaseId] then return false, "ReceiptNotGranted" end
	local ok, reason = ProfileStore.Save(player)
	if not ok then return false, reason end
	local entry = entries[player]
	if entry and entry.SavedRevision < profile.StateRevision then
		return ProfileStore.Save(player)
	end
	return true, nil
end

function ProfileStore.Start(callback)
	onReady = callback
	Players.PlayerAdded:Connect(function(player) task.spawn(load, player) end)
	Players.PlayerRemoving:Connect(function(player)
		local entry = entries[player]
		if entry and entry.Status == "Ready" then
			if entry.Mode == "Sandbox" then ProfileStore.SetStudioSandbox(player, false) end
			local saved = false
			for attempt = 1, 3 do
				saved = ProfileStore.Save(player, true)
				if saved or entry.Status ~= "Ready" then break end
				if attempt < 3 then task.wait(attempt * 2) end
			end
			if not saved then warn("[IdleRaid] Final profile save failed for " .. player.Name) end
		end
		entries[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(load, player) end
	task.spawn(function()
		while true do
			task.wait(GrowthConfig.AutosaveSeconds)
			for player, entry in pairs(entries) do
				if player.Parent == Players and entry.Status == "Ready" then
					task.spawn(ProfileStore.Save, player)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player, entry in pairs(entries) do
			if entry.Status == "Ready" then
				pending += 1
				task.spawn(function()
					if entry.Mode == "Sandbox" then ProfileStore.SetStudioSandbox(player, false) end
					local saved = ProfileStore.Save(player, true)
					if not saved then warn("[IdleRaid] Shutdown profile save failed for " .. player.Name) end
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do task.wait(0.1) end
		if pending > 0 then warn("[IdleRaid] Shutdown timed out with pending profile saves") end
	end)
end

if isMock then
	function ProfileStore.TestOfflineSettle(profile, now: number)
		return offlineSettle(profile, now)
	end
	function ProfileStore.TestFailNextUpdates(count: number)
		assert(SafeInteger.IsValid(count) and count <= 10)
		mockFailures = count
	end
	function ProfileStore.TestSetMock(userId: number, raw)
		mockRecords["Player_" .. tostring(userId)] = clone(raw)
	end
	function ProfileStore.TestGetMock(userId: number)
		return clone(mockRecords["Player_" .. tostring(userId)])
	end
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">RaidService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local EnemyService = require(script.Parent.EnemyService)
local EquipmentService = require(script.Parent.EquipmentService)
local PlayerDataService = require(script.Parent.PlayerDataService)
local GrowthService = require(script.Parent.GrowthService)
local StateSyncService = require(script.Parent.StateSyncService)

local RaidService = {}
local current
local arena: Folder?
local bossSpawn: BasePart?
local joinRemote: RemoteEvent?
local telegraphRemote: RemoteEvent?
local feedbackRemote: RemoteEvent?
local nextId = 0
local lastMetrics
local finishRaid

local function gateDefinition(gateId: string)
	for _, gate in ipairs(GrowthConfig.Gates) do
		if gate.Id == gateId then return gate end
	end
	return nil
end

local function alivePlayers(session)
	local result = {}
	for player in pairs(session.Participants) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player.Parent == Players and (PlayerDataService.GetHealth(player) or 0) > 0
			and root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			table.insert(result, player)
		end
	end
	return result
end

local function pushParticipants(session)
	for player in pairs(session.Participants) do
		StateSyncService.Push(player)
	end
end

local function teleport(player: Player, position: Vector3)
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(position))
	end
end

local function makeArena()
	local existing = Workspace:FindFirstChild("RaidArena")
	if existing and not existing:IsA("Folder") then
		warn("[IdleRaid] Workspace.RaidArena must be a Folder")
		return
	end
	arena = existing or Instance.new("Folder")
	arena.Name = "RaidArena"
	arena.Parent = Workspace

	local floor = arena:FindFirstChild("Floor")
	if not floor then
		floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Anchored = true
		floor.Size = GameConfig.Raid.ArenaSize
		floor.Position = GameConfig.Raid.ArenaCenter - Vector3.new(0, floor.Size.Y / 2, 0)
		floor.Color = Color3.fromRGB(53, 65, 77)
		floor.Parent = arena
	end
	if not floor:IsA("BasePart") then
		warn("[IdleRaid] Workspace.RaidArena.Floor must be a BasePart")
		arena = nil
		return
	end
	local spawn = arena:FindFirstChild("BossSpawn")
	if not spawn then
		spawn = Instance.new("Part")
		spawn.Name = "BossSpawn"
		spawn.Anchored = true
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.Transparency = 1
		spawn.Size = Vector3.new(2, 0.2, 2)
		spawn.Position = GameConfig.Raid.ArenaCenter + Vector3.new(0, 0.2, 18)
		spawn.Parent = arena
	end
	if not spawn:IsA("BasePart") then
		warn("[IdleRaid] Workspace.RaidArena.BossSpawn must be a BasePart")
		arena = nil
		return
	end
	bossSpawn = spawn
end

local function playerStart(index: number): Vector3
	return GameConfig.Raid.ArenaCenter + Vector3.new((index - 2.5) * 5, 4, -20)
end

local function exitPosition(): Vector3
	local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawn then
		return spawn.Position + Vector3.new(0, 5, 0)
	end
	return Vector3.new(0, 5, 0)
end

function RaidService.GetSnapshot(player: Player)
	local session = current
	if not session or not session.Participants[player] then
		return { IsParticipant = false, Status = "Idle" }
	end
	return {
		IsParticipant = true,
		Status = session.Status,
		Phase = session.Phase,
		BossHealth = session.BossHealth,
		BossMaxHealth = session.BossMaxHealth,
		BossName = GameConfig.Enemies.SlimeKing.Name .. " · " .. (gateDefinition(session.GateId).Difficulty),
		GateId = session.GateId,
		Defeated = (PlayerDataService.GetHealth(player) or 0) <= 0,
		DashReadyAt = session.Dash[player] and session.Dash[player].ReadyAt or 0,
	}
end

function RaidService.CanAttack(player: Player, target: Instance): boolean
	local session = current
	local isBoss = target:GetAttribute("IsBoss") == true
	if isBoss then
		return session ~= nil and session.Status == "Active"
			and session.Participants[player] == true and target == session.Boss
			and (PlayerDataService.GetHealth(player) or 0) > 0
	end
	return not (session and session.Participants[player])
end

function RaidService.IsInvulnerable(player: Player): boolean
	local session = current
	local dash = session and session.Dash[player]
	return session ~= nil and session.Status == "Active" and dash ~= nil
		and Workspace:GetServerTimeNow() < dash.InvulnerableUntil
end

function RaidService.TryDash(player: Player, direction): boolean
	local session = current
	if not session or session.Status ~= "Active" or not session.Participants[player]
		or (PlayerDataService.GetHealth(player) or 0) <= 0 then
		return false
	end
	if typeof(direction) ~= "Vector3" or direction.X ~= direction.X or direction.Z ~= direction.Z
		or math.abs(direction.X) > 1000000 or math.abs(direction.Z) > 1000000 then
		return false
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return false end
	local now = Workspace:GetServerTimeNow()
	local previous = session.Dash[player]
	if previous and now < previous.ReadyAt then return false end
	local horizontal = Vector3.new(direction.X, 0, direction.Z)
	if horizontal.Magnitude < 0.01 then return false end
	local center = GameConfig.Raid.ArenaCenter
	local half = GameConfig.Raid.ArenaSize / 2
	local inset = GameConfig.Raid.ArenaInset
	if math.abs(root.Position.X - center.X) > half.X - inset
		or math.abs(root.Position.Z - center.Z) > half.Z - inset then
		return false
	end
	local desired = root.Position + horizontal.Unit * GameConfig.Raid.Dash.Distance
	local destination = Vector3.new(
		math.clamp(desired.X, center.X - half.X + inset, center.X + half.X - inset),
		root.Position.Y,
		math.clamp(desired.Z, center.Z - half.Z + inset, center.Z + half.Z - inset)
	)
	local displacement = destination - root.Position
	if displacement.Magnitude < 0.1 then return false end
	session.Dash[player] = {
		ReadyAt = now + GameConfig.Raid.Dash.Cooldown,
		InvulnerableUntil = now + GameConfig.Raid.Dash.InvulnerableTime,
	}
	character:PivotTo(character:GetPivot() + displacement)
	root.AssemblyLinearVelocity = Vector3.zero
	StateSyncService.Push(player)
	return true
end

function RaidService.GetLastMetrics()
	return lastMetrics
end

local function applyDamage(session, player: Player, amount: number)
	if current ~= session or session.Status ~= "Active" or not session.Participants[player] then return end
	local health = PlayerDataService.GetHealth(player)
	if not health or health <= 0 or RaidService.IsInvulnerable(player) then return end
	local remaining = PlayerDataService.ApplyRaidDamage(player, amount)
	if not remaining then return end
	session.Metrics.Hits += 1
	session.Metrics.HitsByPlayer[player] = (session.Metrics.HitsByPlayer[player] or 0) + 1
	if feedbackRemote then feedbackRemote:FireClient(player, "Taken", health - remaining) end
	if remaining == 0 then
		print(string.format("[IdleRaid] %s defeated in raid", player.Name))
		StateSyncService.Push(player)
		if #alivePlayers(session) == 0 then finishRaid(session, false) end
	end
end

local function horizontalDistance(a: Vector3, b: Vector3): number
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

local function groundSlam(session, targetPlayer: Player)
	local root = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local config = GameConfig.Raid.Slam
	local center = Vector3.new(root.Position.X, GameConfig.Raid.ArenaCenter.Y, root.Position.Z)
	session.Phase = "Telegraph"
	session.Metrics.Slam += 1
	pushParticipants(session)
	for player in pairs(session.Participants) do
		telegraphRemote:FireClient(player, "Slam", center, config.Radius, config.TelegraphTime)
	end
	task.wait(config.TelegraphTime)
	if current ~= session or session.Status ~= "Active" then return end
	session.Phase = "Attack"
	for _, player in ipairs(alivePlayers(session)) do
		local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if playerRoot and horizontalDistance(playerRoot.Position, center) <= config.Radius then
			applyDamage(session, player, math.round(config.Damage * session.Difficulty.DamageMultiplier))
		end
	end
	print("[IdleRaid] Slime King used Ground Slam")
end

local function distanceToSegment(point: Vector3, startPos: Vector3, endPos: Vector3): number
	local a = Vector2.new(startPos.X, startPos.Z)
	local b = Vector2.new(endPos.X, endPos.Z)
	local p = Vector2.new(point.X, point.Z)
	local delta = b - a
	local fraction = math.clamp((p - a):Dot(delta) / math.max(delta:Dot(delta), 0.001), 0, 1)
	return (p - (a + delta * fraction)).Magnitude
end

local function charge(session, targetPlayer: Player)
	local boss = session.Boss
	local body = boss and boss.PrimaryPart
	local root = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not body or not root then return end
	local config = GameConfig.Raid.Charge
	local startPos = body.Position
	local horizontal = Vector3.new(root.Position.X - startPos.X, 0, root.Position.Z - startPos.Z)
	if horizontal.Magnitude < 1 then return end
	local endPos = startPos + horizontal.Unit * math.min(horizontal.Magnitude, config.MaxDistance)
	session.Phase = "Telegraph"
	session.Metrics.Charge += 1
	pushParticipants(session)
	for player in pairs(session.Participants) do
		telegraphRemote:FireClient(player, "Charge", startPos, endPos, config.Width, config.TelegraphTime)
	end
	task.wait(config.TelegraphTime)
	if current ~= session or session.Status ~= "Active" then return end
	session.Phase = "Attack"
	local tween = TweenService:Create(body, TweenInfo.new(config.TravelTime, Enum.EasingStyle.Linear), { Position = endPos })
	tween:Play()
	task.wait(config.TravelTime)
	if current ~= session or session.Status ~= "Active" then return end
	for _, player in ipairs(alivePlayers(session)) do
		local playerRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if playerRoot and distanceToSegment(playerRoot.Position, startPos, endPos) <= config.Width / 2 then
			applyDamage(session, player, math.round(config.Damage * session.Difficulty.DamageMultiplier))
		end
	end
	print("[IdleRaid] Slime King used Charge")
end

local function bossLoop(session)
	local attackIndex = 0
	while current == session and session.Status == "Active" do
		session.Phase = "Idle"
		pushParticipants(session)
		task.wait(GameConfig.Raid.BossAttackInterval)
		if current ~= session or session.Status ~= "Active" then break end
		local players = alivePlayers(session)
		if #players == 0 then
			finishRaid(session, false)
			break
		end
		attackIndex += 1
		local target = players[math.random(1, #players)]
		if attackIndex % 2 == 1 then
			groundSlam(session, target)
		else
			charge(session, target)
		end
		if current ~= session or session.Status ~= "Active" then break end
		session.Phase = "Recovery"
		pushParticipants(session)
		task.wait(GameConfig.Raid.RecoveryTime)
	end
end

finishRaid = function(session, success: boolean)
	if current ~= session or session.Status ~= "Active" then return end
	session.Status = if success then "Clear" else "Failed"
	session.Phase = "Finished"
	if session.Boss then EnemyService.RemoveEnemy(session.Boss) end
	local metrics = session.Metrics
	metrics.Result = if success then "Clear" else "Failed"
	metrics.Duration = math.round((os.clock() - metrics.StartedAt) * 10) / 10
	metrics.Participants = {}
	for player in pairs(session.Participants) do
		local initial = metrics.Initial[player]
		if initial then
			table.insert(metrics.Participants, {
			Name = player.Name,
			Level = initial.Level,
			Equipment = initial.Equipment,
			FinalAttack = initial.FinalAttack,
			Hits = metrics.HitsByPlayer[player] or 0,
			DamageDealt = metrics.DamageByPlayer[player] or 0,
			Defeated = (PlayerDataService.GetHealth(player) or 0) <= 0,
			})
		end
	end
	lastMetrics = {
		Result = metrics.Result, Duration = metrics.Duration,
		Slam = metrics.Slam, Charge = metrics.Charge, Hits = metrics.Hits,
		BossHealthRemaining = if success then 0 else session.BossHealth,
		GateId = session.GateId,
		Participants = metrics.Participants,
	}
	print(string.format("[IdleRaid] RaidMetrics %s %.1fs Slam=%d Charge=%d Hits=%d",
		metrics.Result, metrics.Duration, metrics.Slam, metrics.Charge, metrics.Hits))
	if success then
		session.BossHealth = 0
		local gate = gateDefinition(session.GateId)
		for player in pairs(session.Participants) do
			if player.Parent == Players then
				local profile = PlayerDataService.GetProfile(player)
				if profile then
					local rewardStage = math.min(profile.BreakthroughStage, gate.Stage)
					local rewardPower = GrowthMath.ReferenceRate(rewardStage) * GameConfig.Raid.RewardTrainingSeconds
					local powerGranted = PlayerDataService.AddPowerFinal(player, rewardPower, "RaidClear")
					local goldGranted = PlayerDataService.AddGold(player, session.Difficulty.Gold, "RaidClear")
					local tokensGranted = PlayerDataService.AddRaidToken(player, session.Difficulty.Tokens)
					if not powerGranted or not goldGranted or not tokensGranted then
						warn("[IdleRaid] Raid reward cap prevented a full grant for " .. player.Name)
					end
					local gateCleared = false
					if session.GateEligible[player] and (metrics.DamageByPlayer[player] or 0) > 0 then
						gateCleared = GrowthService.RecordGateClear(player, session.GateId)
					end
					StateSyncService.Push(player, {
						Kind = "RaidReward", GateId = session.GateId,
						Power = if powerGranted then rewardPower else 0,
						Gold = if goldGranted then session.Difficulty.Gold else 0,
						Tokens = if tokensGranted then session.Difficulty.Tokens else 0,
						GateCleared = gateCleared,
					})
				end
			end
		end
	end
	print(if success then "[IdleRaid] RAID CLEAR" else "[IdleRaid] RAID FAILED")
	pushParticipants(session)
	task.delay(GameConfig.Raid.ResultDuration, function()
		if current ~= session then return end
		current = nil
		for player in pairs(session.Participants) do
			if player.Parent == Players then
				PlayerDataService.ResetRaidHealth(player)
				teleport(player, exitPosition())
				StateSyncService.Push(player)
			end
		end
	end)
end

function RaidService.OnBossDamaged(player: Player, target: Instance, dealt: number, killed: boolean)
	local session = current
	if not session or session.Status ~= "Active" or target ~= session.Boss then return end
	session.Metrics.DamageByPlayer[player] = (session.Metrics.DamageByPlayer[player] or 0) + dealt
	if feedbackRemote then feedbackRemote:FireClient(player, "BossDamage", dealt) end
	if killed then
		finishRaid(session, true)
	else
		local health = EnemyService.GetHealthSnapshot(target)
		if health then session.BossHealth = health.Health end
		pushParticipants(session)
	end
end

local function beginRaid(session)
	if current ~= session or session.Status ~= "Gathering" then return end
	local count = 0
	for player in pairs(session.Participants) do
		if player.Parent == Players then count += 1 else session.Participants[player] = nil end
	end
	if count == 0 then current = nil return end
	session.BossMaxHealth = GameConfig.Raid.BossHealthByPlayers[count] * session.Difficulty.HpMultiplier
	session.BossHealth = session.BossMaxHealth
	session.Boss = EnemyService.SpawnAt(bossSpawn, "SlimeKing", {
		MaxHealth = session.BossMaxHealth,
		NoRespawn = true,
	})
	if not session.Boss then
		warn("[IdleRaid] Slime King spawn failed")
		current = nil
		for player in pairs(session.Participants) do
			PlayerDataService.ResetRaidHealth(player)
			teleport(player, exitPosition())
			StateSyncService.Push(player)
		end
		return
	end
	session.Status = "Active"
	session.Phase = "Idle"
	session.Metrics.StartedAt = os.clock()
	for player in pairs(session.Participants) do
		local snapshot = PlayerDataService.GetSnapshot(player)
		session.Metrics.Initial[player] = {
			Level = snapshot and snapshot.Level or 0,
			FinalAttack = snapshot and snapshot.FinalAttack or 0,
			Equipment = EquipmentService.GetSnapshot(player),
		}
	end
	pushParticipants(session)
	print(string.format("[IdleRaid] Raid started with %d player(s), boss HP %d", count, session.BossMaxHealth))
	task.spawn(bossLoop, session)
end

local function joinRaid(player: Player, requestedGate: any)
	local gateId = if requestedGate == nil then "Gate10" else requestedGate
	if typeof(gateId) ~= "string" or not gateDefinition(gateId) then return end
	if gateId ~= "Gate10" and not GrowthService.CanClearGate(player, gateId) then return end
	if not arena or not bossSpawn or not PlayerDataService.GetHealth(player) then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then return end
	if current and (current.Status ~= "Gathering" or current.GateId ~= gateId) then return end
	if not current then
		nextId += 1
		current = {
			Id = nextId, Status = "Gathering", Phase = "Gathering",
			Participants = {}, GateEligible = {}, GateId = gateId,
			Difficulty = GameConfig.Raid.DifficultyByGate[gateId],
			Boss = nil, BossHealth = 0, BossMaxHealth = 0,
			Dash = {},
			Metrics = {
				Slam = 0, Charge = 0, Hits = 0,
				HitsByPlayer = {}, DamageByPlayer = {}, Initial = {},
			},
		}
		local session = current
		task.delay(GameConfig.Raid.JoinWindow, function() beginRaid(session) end)
	end
	if current.Participants[player] then return end
	local count = 0
	for _ in pairs(current.Participants) do count += 1 end
	if count >= GameConfig.Raid.MaxPlayers then return end
	current.Participants[player] = true
	current.GateEligible[player] = GrowthService.CanClearGate(player, gateId)
	PlayerDataService.ResetRaidHealth(player)
	teleport(player, playerStart(count + 1))
	pushParticipants(current)
	print(string.format("[IdleRaid] %s joined raid", player.Name))
	if count + 1 >= GameConfig.Raid.MaxPlayers then beginRaid(current) end
end

function RaidService.Join(player: Player, gateId: string?)
	joinRaid(player, gateId)
end

function RaidService.Start()
	makeArena()
	local folder = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	joinRemote = Instance.new("RemoteEvent")
	joinRemote.Name = "JoinRaid"
	joinRemote.Parent = folder
	joinRemote.OnServerEvent:Connect(joinRaid)
	telegraphRemote = Instance.new("RemoteEvent")
	telegraphRemote.Name = "RaidTelegraph"
	telegraphRemote.Parent = folder
	feedbackRemote = Instance.new("RemoteEvent")
	feedbackRemote.Name = "RaidCombatFeedback"
	feedbackRemote.Parent = folder
	local dashRemote = Instance.new("RemoteEvent")
	dashRemote.Name = "RaidDash"
	dashRemote.Parent = folder
	dashRemote.OnServerEvent:Connect(function(player, direction)
		RaidService.TryDash(player, direction)
	end)

	local boundaryElapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		boundaryElapsed += dt
		if boundaryElapsed < GameConfig.Raid.BoundaryCheckInterval then return end
		boundaryElapsed = 0
		local session = current
		if not session then return end
		local center = GameConfig.Raid.ArenaCenter
		local half = GameConfig.Raid.ArenaSize / 2
		local inset = GameConfig.Raid.ArenaInset
		for player in pairs(session.Participants) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local position = root.Position
				local x = math.clamp(position.X, center.X - half.X + inset, center.X + half.X - inset)
				local z = math.clamp(position.Z, center.Z - half.Z + inset, center.Z + half.Z - inset)
				if x ~= position.X or z ~= position.Z or position.Y < center.Y - 10 or position.Y > center.Y + 25 then
					character:PivotTo(CFrame.new(x, center.Y + 4, z))
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local session = current
		if not session or not session.Participants[player] then return end
		session.Participants[player] = nil
		session.Dash[player] = nil
		if next(session.Participants) == nil then
			if session.Boss then EnemyService.RemoveEnemy(session.Boss) end
			current = nil
			print("[IdleRaid] Empty raid cleaned up")
		elseif session.Status == "Active" and #alivePlayers(session) == 0 then
			finishRaid(session, false)
		else
			pushParticipants(session)
		end
	end)
	local function watchCharacter(player)
		player.CharacterRemoving:Connect(function()
			local session = current
			if not session or not session.Participants[player] then return end
			if session.Status == "Gathering" then
				session.Participants[player] = nil
				session.Dash[player] = nil
				if next(session.Participants) == nil then current = nil end
				StateSyncService.Push(player)
			elseif session.Status == "Active" then
				local health = PlayerDataService.GetHealth(player)
				if health and health > 0 then PlayerDataService.ApplyRaidDamage(player, health) end
				if #alivePlayers(session) == 0 then finishRaid(session, false) end
			end
		end)
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				local root = character:WaitForChild("HumanoidRootPart", 5)
				local session = current
				if root and session and session.Participants[player] then
					teleport(player, playerStart(1))
					StateSyncService.Push(player)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(watchCharacter)
	for _, player in ipairs(Players:GetPlayers()) do watchCharacter(player) end
end

return RaidService
]]></string>
        </Properties>
