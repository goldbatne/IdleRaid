      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">StatService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)

local StatService = {}

function StatService.GetEquipmentBonuses(equipment): (number, number)
	local attack = 0
	local defense = 0
	for _, itemId in pairs(equipment) do
		local definition = ItemConfig.Items[itemId]
		if definition then
			attack += definition.Attack or 0
			defense += definition.Defense or 0
		end
	end
	return attack, defense
end

function StatService.Calculate(data): (number, number)
	local levelAttackBonus = (data.Level - 1) * GameConfig.Level.AttackIncreasePerLevel
	return data.BaseAttack + levelAttackBonus + data.EquipmentAttackBonus,
		data.BaseDefense + data.EquipmentDefenseBonus
end

return StatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">StateSyncService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StateSyncService = {}
local snapshotProvider
local updatedRemote: RemoteEvent?
local started = false
local lastRequestAt = {}
local revisions = {}
local initialSent = {}

local function send(player: Player, kind: string, notification)
	if not updatedRemote or not snapshotProvider or player.Parent ~= Players then return end
	local snapshot = snapshotProvider(player, kind)
	if not snapshot then return end
	local revision = (revisions[player] or 0) + 1
	revisions[player] = revision
	snapshot.StateRevision = revision
	if kind == "Growth" then snapshot._Partial = true end
	if kind == "Full" then initialSent[player] = true end
	updatedRemote:FireClient(player, snapshot, notification)
end

function StateSyncService.Push(player: Player, notification)
	send(player, "Full", notification)
end

function StateSyncService.PushGrowth(player: Player, notification)
	if not initialSent[player] then send(player, "Full", notification)
	else send(player, "Growth", notification) end
end

function StateSyncService.Start(provider)
	if started then return end
	started = true
	snapshotProvider = provider
	local folder = ReplicatedStorage:FindFirstChild("IdleRaidRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "IdleRaidRemotes"
		folder.Parent = ReplicatedStorage
	end
	local updated = Instance.new("RemoteEvent")
	updated.Name = "PlayerStateUpdated"
	updated.Parent = folder
	updatedRemote = updated
	local request = Instance.new("RemoteEvent")
	request.Name = "RequestPlayerState"
	request.Parent = folder
	request.OnServerEvent:Connect(function(player)
		local now = os.clock()
		if now - (lastRequestAt[player] or -math.huge) < 1 then return end
		lastRequestAt[player] = now
		StateSyncService.Push(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastRequestAt[player] = nil
		revisions[player] = nil
		initialSent[player] = nil
	end)
end

return StateSyncService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">TrainingService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local SafeInteger = require(ReplicatedStorage.Shared.SafeInteger)
local PlayerDataService = require(script.Parent.PlayerDataService)
local ProfileStore = require(script.Parent.ProfileStore)
local StateSyncService = require(script.Parent.StateSyncService)

local TrainingService = {}
local lastAt = {}
local MAX_CHUNK_MILLIS = 60000

function TrainingService.Settle(player: Player): boolean
	local now = os.clock()
	local profile = ProfileStore.Get(player)
	if not profile then lastAt[player] = nil return false end
	local previous = lastAt[player]
	if not previous then lastAt[player] = now return true end
	local millis = math.floor((now - previous) * 1000)
	if millis <= 0 then return true end
	lastAt[player] = previous + millis / 1000
	if not profile.TrainingEnabled then return true end
	local rate = GrowthMath.BaseRate(profile.BreakthroughStage, profile.TrainingFacilityTier)
	if not rate then return false end
	local remaining = millis
	local remainder = profile.TrainingRemainderMillis
	local grant = 0
	while remaining > 0 do
		local chunk = math.min(remaining, MAX_CHUNK_MILLIS)
		local numerator = SafeInteger.Multiply(rate, chunk)
		if not numerator then return false end
		local total = SafeInteger.Add(numerator, remainder)
		if not total then return false end
		local gained = math.floor(total / 1000)
		local nextGrant = SafeInteger.Add(grant, gained)
		if not nextGrant then return false end
		grant = nextGrant
		remainder = total % 1000
		remaining -= chunk
	end
	if grant > 0 and not PlayerDataService.AddPowerFinal(player, grant, "OnlineTraining") then
		warn("[IdleRaid] Training power cap reached for " .. player.Name)
		return false
	end
	profile.TrainingRemainderMillis = remainder
	return true
end

function TrainingService.SetEnabled(player: Player, enabled: any): boolean
	if typeof(enabled) ~= "boolean" then return false end
	local profile = ProfileStore.Get(player)
	if not profile then return false end
	TrainingService.Settle(player)
	if profile.TrainingEnabled == enabled then return true end
	profile.TrainingEnabled = enabled
	ProfileStore.Touch(player)
	StateSyncService.PushGrowth(player)
	return true
end

function TrainingService.ResetClock(player: Player)
	lastAt[player] = os.clock()
end

function TrainingService.Start()
	ProfileStore.SetBeforeSave(TrainingService.Settle)
	Players.PlayerRemoving:Connect(function(player) lastAt[player] = nil end)
	local remote = Instance.new("RemoteEvent")
	remote.Name = "SetTrainingEnabled"
	remote.Parent = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	remote.OnServerEvent:Connect(function(player, enabled)
		TrainingService.SetEnabled(player, enabled)
	end)
	task.spawn(function()
		while true do
			task.wait(GrowthConfig.OnlineTickSeconds)
			for _, player in ipairs(Players:GetPlayers()) do TrainingService.Settle(player) end
		end
	end)
end

return TrainingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">WorldVisualService</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)

local WorldVisualService = {}

function WorldVisualService.EnsureSpawn()
	if Workspace:FindFirstChildWhichIsA("SpawnLocation", true) then return end
	local root = Workspace:FindFirstChild("IdleRaidVisuals")
	if root and not root:IsA("Folder") then
		warn("[IdleRaid] Workspace.IdleRaidVisuals must be a Folder")
		return
	end
	if not root then
		root = Instance.new("Folder")
		root.Name = "IdleRaidVisuals"
		root.Parent = Workspace
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GeneratedPlayerSpawn"
	spawn.Size = Vector3.new(7, 1, 7)
	spawn.Position = Vector3.new(0, 0, 0)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Transparency = 0.45
	spawn.Color = Color3.fromRGB(114, 190, 167)
	spawn.Parent = root
end

local function piece(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, collide: boolean?)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = collide == true
	part.CanTouch = false
	part.CanQuery = collide == true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Parent = parent
	return part
end

local function sphere(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material)
	local part = piece(parent, name, size, CFrame.new(position), color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

local function tree(parent: Instance, position: Vector3, index: number)
	local wood = Color3.fromRGB(115, 79, 62)
	local leaves = Color3.fromRGB(55, 149, 117)
	piece(parent, "TreeTrunk" .. index, Vector3.new(1.4, 8, 1.4), CFrame.new(position + Vector3.new(0, 4, 0)),
		wood, Enum.Material.Wood)
	sphere(parent, "TreeCrown" .. index, Vector3.new(7, 6, 7), position + Vector3.new(0, 9, 0), leaves, Enum.Material.Grass)
	sphere(parent, "TreeCrownTop" .. index, Vector3.new(5.5, 4.5, 5.5),
		position + Vector3.new(0, 12.2, 0), Color3.fromRGB(77, 182, 132), Enum.Material.Grass)
end

local function field(folder: Folder, onPortalTriggered, onFacilityTriggered)
	local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local origin = spawn and spawn.Position or Vector3.new(0, 0, 0)
	local y = origin.Y - 0.05
	piece(folder, "GrassField", Vector3.new(96, 0.4, 120),
		CFrame.new(origin.X, y - 0.2, origin.Z - 20),
		Color3.fromRGB(95, 174, 105), Enum.Material.Grass, true)
	piece(folder, "VillagePath", Vector3.new(12, 0.08, 76),
		CFrame.new(origin.X, y + 0.02, origin.Z - 25),
		Color3.fromRGB(205, 183, 140), Enum.Material.Sand)
	piece(folder, "HuntClearing", Vector3.new(43, 0.09, 21),
		CFrame.new(origin.X, y + 0.04, origin.Z - 17),
		Color3.fromRGB(116, 186, 112), Enum.Material.Grass)

	piece(folder, "FoothillClearing", Vector3.new(49, 0.09, 20),
		CFrame.new(origin.X, y + 0.04, origin.Z - 34), Color3.fromRGB(141, 179, 119), Enum.Material.Grass)
	piece(folder, "CitadelClearing", Vector3.new(52, 0.09, 20),
		CFrame.new(origin.X, y + 0.04, origin.Z - 58), Color3.fromRGB(124, 154, 152), Enum.Material.Slate)
	local spawns = Workspace:FindFirstChild("EnemySpawns")
	if spawns then
		for _, spawnPoint in ipairs(spawns:GetChildren()) do
			if spawnPoint:IsA("BasePart") then
				local pad = piece(folder, "HuntPad_" .. spawnPoint.Name,
					Vector3.new(0.08, 4.5, 4.5),
					CFrame.new(spawnPoint.Position.X, y + 0.07, spawnPoint.Position.Z) * CFrame.Angles(0, 0, math.pi / 2),
					Color3.fromRGB(158, 237, 143), Enum.Material.Neon)
				pad.Shape = Enum.PartType.Cylinder
				pad.Transparency = 0.65
			end
		end
	end

	local trees = {
		Vector3.new(-34, 0, -30), Vector3.new(-25, 0, 21), Vector3.new(34, 0, -27),
		Vector3.new(36, 0, 17), Vector3.new(-40, 0, 7), Vector3.new(19, 0, -35),
	}
	for index, offset in ipairs(trees) do
		tree(folder, Vector3.new(origin.X + offset.X, y, origin.Z + offset.Z), index)
	end
	for index, offset in ipairs({
		Vector3.new(-28, 0, -14), Vector3.new(30, 0, -9), Vector3.new(-16, 0, 17),
		Vector3.new(13, 0, 23), Vector3.new(-38, 0, -20), Vector3.new(39, 0, -17),
	}) do
		sphere(folder, "FieldRock" .. index, Vector3.new(3.5, 2.1, 2.8),
			Vector3.new(origin.X + offset.X, y + 0.7, origin.Z + offset.Z),
			Color3.fromRGB(111, 133, 127), Enum.Material.Slate)
	end

	local facilityAt = Vector3.new(origin.X - 22, y, origin.Z + 13)
	local pedestal = piece(folder, "TrainingFacility", Vector3.new(6, 2, 6),
		CFrame.new(facilityAt + Vector3.new(0, 1, 0)),
		Color3.fromRGB(88, 107, 164), Enum.Material.Slate, true)
	sphere(folder, "TrainingCrystal", Vector3.new(2.8, 3.8, 2.8),
		facilityAt + Vector3.new(0, 3.5, 0), Color3.fromRGB(94, 234, 215), Enum.Material.Neon)
	local facilityPrompt = Instance.new("ProximityPrompt")
	facilityPrompt.ActionText = "성장 메뉴 열기"
	facilityPrompt.ObjectText = "수련 시설"
	facilityPrompt.HoldDuration = 0
	facilityPrompt.MaxActivationDistance = 12
	facilityPrompt.Parent = pedestal
	facilityPrompt.Triggered:Connect(onFacilityTriggered)
	local portalAt = Vector3.new(origin.X + 23, y, origin.Z + 13)
	local base = piece(folder, "RaidPortalBase", Vector3.new(0.25, 11, 11),
		CFrame.new(portalAt + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(62, 72, 115), Enum.Material.Slate)
	base.Shape = Enum.PartType.Cylinder
	for _, x in ipairs({ -3.1, 3.1 }) do
		piece(folder, "PortalPillar", Vector3.new(1, 7, 1), CFrame.new(portalAt + Vector3.new(x, 3.5, 0)),
			Color3.fromRGB(92, 100, 151), Enum.Material.Slate)
	end
	local crystal = sphere(folder, "RaidPortal", Vector3.new(3.2, 4.5, 3.2),
		portalAt + Vector3.new(0, 4.2, 0), Color3.fromRGB(119, 175, 255), Enum.Material.Neon)
	crystal.Transparency = 0.16
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Enter Raid"
	prompt.ObjectText = "Slime King"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.Parent = crystal
	prompt.Triggered:Connect(onPortalTriggered)
end

local function arenaVisuals(arena: Folder)
	if arena:FindFirstChild("GeneratedVisuals") then return end
	local visuals = Instance.new("Folder")
	visuals.Name = "GeneratedVisuals"
	visuals.Parent = arena
	local center = GameConfig.Raid.ArenaCenter
	local floor = arena:FindFirstChild("Floor")
	local floorTop = if floor and floor:IsA("BasePart") then floor.Position.Y + floor.Size.Y / 2 else center.Y
	local disk = piece(visuals, "MoonstoneCircle", Vector3.new(0.09, 88, 88),
		CFrame.new(center.X, floorTop + 0.04, center.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color3.fromRGB(43, 53, 82), Enum.Material.Slate)
	disk.Shape = Enum.PartType.Cylinder
	for index = 1, 20 do
		local angle = index * math.pi * 2 / 20
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local at = center + radial * 44
		piece(visuals, "ArenaRune" .. index, Vector3.new(3, 0.1, 0.45),
			CFrame.new(at.X, floorTop + 0.12, at.Z) * CFrame.Angles(0, -angle, 0),
			Color3.fromRGB(113, 190, 243), Enum.Material.Neon)
	end
	for index, offset in ipairs({
		Vector3.new(-46, 0, -46), Vector3.new(46, 0, -46),
		Vector3.new(-46, 0, 46), Vector3.new(46, 0, 46),
	}) do
		piece(visuals, "ArenaObelisk" .. index, Vector3.new(2, 12, 2),
			CFrame.new(center + offset + Vector3.new(0, 6, 0)),
			Color3.fromRGB(74, 89, 136), Enum.Material.Slate)
		sphere(visuals, "ArenaCrystal" .. index, Vector3.new(2.2, 3, 2.2),
			center + offset + Vector3.new(0, 13, 0), Color3.fromRGB(130, 178, 255), Enum.Material.Neon)
	end
end

function WorldVisualService.Start(onPortalTriggered)
	local openGrowth = Instance.new("RemoteEvent")
	openGrowth.Name = "OpenGrowthMenu"
	openGrowth.Parent = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local function onFacilityTriggered(player)
		openGrowth:FireClient(player)
	end
	local root = Workspace:FindFirstChild("IdleRaidVisuals")
	if root and not root:IsA("Folder") then
		warn("[IdleRaid] Workspace.IdleRaidVisuals must be a Folder")
		return
	end
	if not root then
		root = Instance.new("Folder")
		root.Name = "IdleRaidVisuals"
		root.Parent = Workspace
	end
	local generated = root:FindFirstChild("GeneratedField")
	if not generated then
		generated = Instance.new("Folder")
		generated.Name = "GeneratedField"
		generated.Parent = root
		field(generated, onPortalTriggered, onFacilityTriggered)
	elseif generated:IsA("Folder") then
		-- A saved field from the previous version may not contain the training facility.
		-- Add only the missing managed object; keep every existing Studio object.
		local pedestal = generated:FindFirstChild("TrainingFacility")
		if not pedestal then
			local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
			local origin = spawn and spawn.Position or Vector3.zero
			local at = Vector3.new(origin.X - 22, origin.Y - 0.05, origin.Z + 13)
			pedestal = piece(generated, "TrainingFacility", Vector3.new(6, 2, 6),
				CFrame.new(at + Vector3.new(0, 1, 0)),
				Color3.fromRGB(88, 107, 164), Enum.Material.Slate, true)
			if not generated:FindFirstChild("TrainingCrystal") then
				sphere(generated, "TrainingCrystal", Vector3.new(2.8, 3.8, 2.8),
					at + Vector3.new(0, 3.5, 0), Color3.fromRGB(94, 234, 215), Enum.Material.Neon)
			end
		end
		if pedestal:IsA("BasePart") then
			local prompt = pedestal:FindFirstChildOfClass("ProximityPrompt")
			if not prompt then
				prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "성장 메뉴 열기"
				prompt.ObjectText = "수련 시설"
				prompt.HoldDuration = 0
				prompt.MaxActivationDistance = 12
				prompt.Parent = pedestal
			end
			prompt.Triggered:Connect(onFacilityTriggered)
		else
			warn("[IdleRaid] Existing TrainingFacility is not a BasePart")
		end
	else
		warn("[IdleRaid] Existing GeneratedField is not a Folder")
	end
	local raidArena = Workspace:FindFirstChild("RaidArena")
	if raidArena and raidArena:IsA("Folder") then
		arenaVisuals(raidArena)
	end
end

return WorldVisualService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="27">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="28">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">AutoCombatController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local StateController = require(script.Parent.StateController)

local AutoCombatController = {}

local player = Players.LocalPlayer
local enabled = false
local raidParticipant = false
local raidActive = false
local raidDefeated = false
local target: Model?
local moving = false
local lastMoveAt = -math.huge
local lastAttackRequestAt = -math.huge
local heldMovementKeys = {}
local heldMovementTouches = {}
local manualUntil = -math.huge
local changed = Instance.new("BindableEvent")

local movementKeys = {
	[Enum.KeyCode.W] = true,
	[Enum.KeyCode.A] = true,
	[Enum.KeyCode.S] = true,
	[Enum.KeyCode.D] = true,
	[Enum.KeyCode.Up] = true,
	[Enum.KeyCode.Down] = true,
	[Enum.KeyCode.Left] = true,
	[Enum.KeyCode.Right] = true,
}

local function getCharacterParts(): (Humanoid?, BasePart?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

local function stopAutoMove()
	if not moving then
		return
	end
	moving = false
	local humanoid, root = getCharacterParts()
	if humanoid and root then
		humanoid:MoveTo(root.Position)
	end
end

local function getEnemyFolder(): Folder?
	local folder = Workspace:FindFirstChild("Enemies")
	return if folder and folder:IsA("Folder") then folder else nil
end

local function getEnemyPosition(enemy: Model, folder: Folder): Vector3?
	if enemy.Parent ~= folder or typeof(enemy:GetAttribute("EnemyId")) ~= "string"
		or (enemy:GetAttribute("IsBoss") == true) ~= raidParticipant then
		return nil
	end
	local state = StateController.GetSnapshot()
	local requiredStage = enemy:GetAttribute("RequiredStage")
	if typeof(requiredStage) == "number" and (not state or (state.BreakthroughStage or 1) < requiredStage) then
		return nil
	end
	local health = enemy:GetAttribute("Health")
	if typeof(health) ~= "number" or health <= 0 then
		return nil
	end
	local body = enemy.PrimaryPart
	return body and body.Position or nil
end

local function findNearestEnemy(root: BasePart, folder: Folder): Model?
	local nearest: Model?
	local nearestDistance = math.huge
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			local position = getEnemyPosition(child, folder)
			if position then
				local distance = (root.Position - position).Magnitude
				if distance < nearestDistance then
					nearest = child
					nearestDistance = distance
				end
			end
		end
	end
	return nearest
end

local function isMovingManually(): boolean
	return next(heldMovementKeys) ~= nil or next(heldMovementTouches) ~= nil or os.clock() < manualUntil
end

local function update(attackRemote: RemoteEvent)
	if not enabled then
		return
	end
	if raidParticipant and (not raidActive or raidDefeated) then
		target = nil
		stopAutoMove()
		return
	end

	local humanoid, root = getCharacterParts()
	if not humanoid or not root then
		target = nil
		moving = false
		return
	end

	local folder = getEnemyFolder()
	if not folder then
		target = nil
		stopAutoMove()
		return
	end

	local position = if target then getEnemyPosition(target, folder) else nil
	if not position then
		target = findNearestEnemy(root, folder)
		position = if target then getEnemyPosition(target, folder) else nil
		lastMoveAt = -math.huge
	end
	if not target or not position then
		stopAutoMove()
		return
	end

	if isMovingManually() then
		stopAutoMove()
		return
	end
	local distance = (root.Position - position).Magnitude
	if distance > GameConfig.Combat.AttackRange then

		local horizontal = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
		if horizontal.Magnitude > 0 then
			local now = os.clock()
			if not moving or now - lastMoveAt >= GameConfig.AutoCombat.MoveRefreshInterval then
				local travel = math.max(0, horizontal.Magnitude - GameConfig.AutoCombat.ApproachDistance)
				humanoid:MoveTo(root.Position + horizontal.Unit * travel)
				moving = true
				lastMoveAt = now
			end
		end
		return
	end

	stopAutoMove()
	local now = os.clock()
	if now - lastAttackRequestAt >= GameConfig.AutoCombat.AttackRequestInterval then
		lastAttackRequestAt = now
		attackRemote:FireServer(target)
	end
end

function AutoCombatController.PauseForDash()
	manualUntil = math.max(manualUntil, os.clock() + GameConfig.Raid.Dash.ManualPauseTime)
	stopAutoMove()
end

function AutoCombatController.GetEnabled(): boolean
	return enabled
end

function AutoCombatController.OnChanged(callback)
	local connection = changed.Event:Connect(callback)
	callback(enabled)
	return connection
end

function AutoCombatController.SetEnabled(nextEnabled: boolean)
	if enabled == nextEnabled then
		return
	end
	enabled = nextEnabled
	target = nil
	if not enabled then
		stopAutoMove()
	end
	print(if enabled then "[IdleRaid] AutoCombat ON" else "[IdleRaid] AutoCombat OFF")
	changed:Fire(enabled)
end

function AutoCombatController.Toggle()
	AutoCombatController.SetEnabled(not enabled)
end

function AutoCombatController.Start()
	local attackRemote = ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("BasicAttack")
	StateController.Subscribe(function(state)
		local raid = state.Raid or {}
		local wasParticipant = raidParticipant
		raidParticipant = raid.IsParticipant == true
		raidActive = raid.Status == "Active"
		raidDefeated = raid.Defeated == true
		if wasParticipant ~= raidParticipant or not raidActive or raidDefeated then
			target = nil
			stopAutoMove()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType == Enum.UserInputType.Touch then
			local camera = Workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize
			if viewport and input.Position.X < viewport.X * 0.45 and input.Position.Y > viewport.Y * 0.4 then
				heldMovementTouches[input] = true
				stopAutoMove()
			end
			return
		end
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.T then
			AutoCombatController.Toggle()
		elseif movementKeys[input.KeyCode] then
			heldMovementKeys[input.KeyCode] = true
			stopAutoMove()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			heldMovementTouches[input] = nil
		end
		if movementKeys[input.KeyCode] then
			heldMovementKeys[input.KeyCode] = nil
		end
	end)

	player.CharacterAdded:Connect(function()
		moving = false
		table.clear(heldMovementKeys)
		table.clear(heldMovementTouches)
		manualUntil = -math.huge
		AutoCombatController.SetEnabled(false)
		target = nil
	end)

	task.spawn(function()
		while true do
			update(attackRemote)
			task.wait(GameConfig.AutoCombat.TargetScanInterval)
		end
	end)
end

return AutoCombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local CombatController = {}

function CombatController.Start()
	local mouse = Players.LocalPlayer:GetMouse()
	local attackRemote = ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("BasicAttack")

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local target = mouse.Target
		while target and target ~= workspace do
			if target:IsA("Model") and target:GetAttribute("EnemyId") then
				attackRemote:FireServer(target)
				return
			end
			target = target.Parent
		end
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">CombatVisualController</string>
            <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local CombatVisualController = {}

local function effectPart(folder: Folder, name: string, size: Vector3, cframe: CFrame, color: Color3)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Size = size
	part.CFrame = cframe
	part.Parent = folder
	return part
end

local function burst(folder: Folder, position: Vector3, color: Color3, big: boolean)
	local count = if big then 8 else 4
	for index = 1, count do
		local angle = index * math.pi * 2 / count
		local start = position + Vector3.new(math.cos(angle), 0.3, math.sin(angle)) * 0.5
		local part = effectPart(folder, "Spark", Vector3.new(0.35, 0.35, 0.35), CFrame.new(start), color)
		part.Shape = Enum.PartType.Ball
		part.Transparency = 0.1
		TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = start + Vector3.new(math.cos(angle) * 2.1, 1.4, math.sin(angle) * 2.1),
			Size = Vector3.new(0.08, 0.08, 0.08),
			Transparency = 1,
		}):Play()
		Debris:AddItem(part, 0.5)
	end
end

local function number(folder: Folder, position: Vector3, amount: number)
	local anchor = effectPart(folder, "DamageNumber", Vector3.new(0.1, 0.1, 0.1),
		CFrame.new(position + Vector3.new(0, 2.4, 0)), Color3.new(1, 1, 1))
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Adornee = anchor
	gui.AlwaysOnTop = true
	gui.Size = UDim2.fromOffset(96, 48)
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 24
	label.TextStrokeTransparency = 0.25
	label.TextColor3 = Color3.fromRGB(255, 230, 140)
	label.Text = tostring(amount)
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(0.65), {
		Position = anchor.Position + Vector3.new(0, 1.8, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.65), {
		TextTransparency = 1, TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(anchor, 0.7)
end

function CombatVisualController.Start()
	local folder = Instance.new("Folder")
	folder.Name = "IdleRaidClientEffects"
	folder.Parent = Workspace
	ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("CombatVisual").OnClientEvent:Connect(
		function(attacker, enemyId, position, dealt, killed)
			if typeof(position) ~= "Vector3" or typeof(dealt) ~= "number" or dealt <= 0
				or not GameConfig.Enemies[enemyId] or #folder:GetChildren() > 48 then
				return
			end
			local isBoss = enemyId == "SlimeKing"
			local color = if isBoss then Color3.fromRGB(255, 183, 97) else Color3.fromRGB(133, 255, 171)
			local root = attacker and attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local center = root.Position:Lerp(position, 0.72)
				local slash = effectPart(folder, "AttackSlash", Vector3.new(0.18, if isBoss then 6 else 3.4, 0.55),
					CFrame.lookAt(center, position) * CFrame.Angles(0, 0, math.rad(55)), color)
				TweenService:Create(slash, TweenInfo.new(0.23), {
					Transparency = 1, Size = Vector3.new(0.08, 0.6, 0.2),
				}):Play()
				Debris:AddItem(slash, 0.28)
			end
			burst(folder, position, color, killed == true)
			if not isBoss then number(folder, position, dealt) end
			if killed == true then
				local flare = effectPart(folder, "DefeatFlare", Vector3.new(0.8, 0.8, 0.8),
					CFrame.new(position), color)
				flare.Shape = Enum.PartType.Ball
				TweenService:Create(flare, TweenInfo.new(0.5), {
					Size = Vector3.new(5, 5, 5), Transparency = 1,
				}):Play()
				Debris:AddItem(flare, 0.55)
			end
		end
	)
end

return CombatVisualController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DashController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local AutoCombatController = require(script.Parent.AutoCombatController)
local StateController = require(script.Parent.StateController)

local DashController = {}

local player = Players.LocalPlayer
local raidActive = false
local defeated = false
local lastRequestAt = -math.huge

local function inputDirection(root: BasePart, humanoid: Humanoid): Vector3
	local camera = Workspace.CurrentCamera
	local forward = camera and camera.CFrame.LookVector or root.CFrame.LookVector
	local right = camera and camera.CFrame.RightVector or root.CFrame.RightVector
	local direction = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		direction += forward
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		direction -= forward
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		direction += right
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		direction -= right
	end
	if direction.Magnitude < 0.01 and UserInputService.TouchEnabled then
		direction = humanoid.MoveDirection
	end
	if direction.Magnitude < 0.01 then
		direction = root.CFrame.LookVector
	end
	return Vector3.new(direction.X, 0, direction.Z)
end

function DashController.Request()
	if not raidActive or defeated or os.clock() - lastRequestAt < 0.1 then return end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then return end
	local direction = inputDirection(root, humanoid)
	if direction.Magnitude < 0.01 then return end
	lastRequestAt = os.clock()
	AutoCombatController.PauseForDash()
	ReplicatedStorage.IdleRaidRemotes.RaidDash:FireServer(direction)
end

function DashController.Start()
	StateController.Subscribe(function(state)
		local raid = state.Raid or {}
		raidActive = raid.IsParticipant == true and raid.Status == "Active"
		defeated = raid.Defeated == true
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Q then
			DashController.Request()
		end
	end)
end

return DashController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">EnemyVisualController</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EnemyVisualController = {}

function EnemyVisualController.Start()
	local folder = Workspace:WaitForChild("Enemies")
	local tracked = {}
	local serial = 0

	local function register(model: Instance)
		if not model:IsA("Model") or tracked[model] then return end
		local body = model.PrimaryPart
		if not body then return end
		local initialHealth = model:GetAttribute("Health")
		local state = {
			BasePivot = model:GetPivot(),
			BaseColor = body.Color,
			Health = initialHealth,
			Phase = #folder:GetChildren() * 0.7,
			Flash = 0,
		}
		tracked[model] = state
		local function updateHealth()
			local health = model:GetAttribute("Health")
			local maxHealth = model:GetAttribute("MaxHealth")
			local nameplate = model:FindFirstChild("Nameplate")
			local track = nameplate and nameplate:FindFirstChild("HealthTrack")
			local fill = track and track:FindFirstChild("Fill")
			if fill and fill:IsA("Frame") and typeof(health) == "number" and typeof(maxHealth) == "number" then
				fill.Size = UDim2.fromScale(math.clamp(health / math.max(1, maxHealth), 0, 1), 1)
			end
			if typeof(health) == "number" and typeof(state.Health) == "number" and health < state.Health and health > 0 then
				state.Flash += 1
				local flash = state.Flash
				body.Color = Color3.fromRGB(255, 246, 249)
				task.delay(0.12, function()
					if tracked[model] == state and state.Flash == flash and body.Parent then
						body.Color = state.BaseColor
					end
				end)
			end
			state.Health = health
		end
		state.HealthConnection = model:GetAttributeChangedSignal("Health"):Connect(updateHealth)
		state.DestroyConnection = model.Destroying:Connect(function()
			state.HealthConnection:Disconnect()
			state.DestroyConnection:Disconnect()
			tracked[model] = nil
		end)
		updateHealth()
	end

	for _, child in ipairs(folder:GetChildren()) do register(child) end
	folder.ChildAdded:Connect(register)

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.05 then return end
		elapsed = 0
		local now = os.clock()
		for model, state in pairs(tracked) do
			if model.Parent == folder and model:GetAttribute("IsBoss") ~= true and model.PrimaryPart then
				model:PivotTo(state.BasePivot * CFrame.new(0, math.sin(now * 2.8 + state.Phase) * 0.16, 0))
			end
		end
	end)

	ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("RaidTelegraph").OnClientEvent:Connect(function(kind, _, _, third, duration)
		local boss = folder:FindFirstChild("SlimeKing")
		local highlight = boss and boss:FindFirstChild("VisualHighlight")
		if not highlight or not highlight:IsA("Highlight") then return end
		serial += 1
		local this = serial
		highlight.FillColor = if kind == "Slam" then Color3.fromRGB(255, 164, 75) else Color3.fromRGB(208, 112, 255)
		highlight.FillTransparency = 0.55
		local lifetime = if kind == "Slam" then third else duration
		task.delay(if typeof(lifetime) == "number" then lifetime else 1, function()
			if serial == this and highlight.Parent then
				highlight.FillTransparency = 1
			end
		end)
	end)
end

return EnemyVisualController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local CombatController = require(script.Parent.CombatController)
local CombatVisualController = require(script.Parent.CombatVisualController)
local EnemyVisualController = require(script.Parent.EnemyVisualController)
local AutoCombatController = require(script.Parent.AutoCombatController)
local StateController = require(script.Parent.StateController)
local DashController = require(script.Parent.DashController)
local UIController = require(script.Parent.UIController)

CombatController.Start()
CombatVisualController.Start()
EnemyVisualController.Start()
AutoCombatController.Start()
DashController.Start()
UIController.Start()
StateController.Start()

print("[IdleRaid] Client Started")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">StateController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StateController = {}
local changed = Instance.new("BindableEvent")
local notificationReceived = Instance.new("BindableEvent")
local currentState
local offlineShown = false

function StateController.Subscribe(callback)
	local connection = changed.Event:Connect(callback)
	if currentState then callback(currentState) end
	return connection
end

function StateController.OnNotification(callback)
	return notificationReceived.Event:Connect(callback)
end

function StateController.GetSnapshot()
	return currentState
end

function StateController.Start()
	local remotes = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local updated = remotes:WaitForChild("PlayerStateUpdated")
	updated.OnClientEvent:Connect(function(snapshot, notification)
		if typeof(snapshot) ~= "table" or typeof(snapshot.StateRevision) ~= "number" then return end
		if currentState and snapshot.StateRevision <= (currentState.StateRevision or -1) then return end
		if snapshot._Partial and currentState then
			for key, value in pairs(snapshot) do
				if key ~= "_Partial" then currentState[key] = value end
			end
		else
			currentState = snapshot
		end
		changed:Fire(currentState)
		if not offlineShown and currentState.Ready and typeof(currentState.OfflineSummary) == "table" then
			offlineShown = true
			notificationReceived:Fire({ Kind = "Offline", Summary = currentState.OfflineSummary })
		end
		if typeof(notification) == "table" then notificationReceived:Fire(notification) end
	end)
	remotes:WaitForChild("RequestPlayerState"):FireServer()
end

return StateController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local AutoCombatController = require(script.Parent.AutoCombatController)
local StateController = require(script.Parent.StateController)
local EquipmentController = require(script.Parent.ui.EquipmentController)
local DashController = require(script.Parent.DashController)
local HUDController = require(script.Parent.ui.HUDController)
local InventoryController = require(script.Parent.ui.InventoryController)
local NotificationController = require(script.Parent.ui.NotificationController)
local RaidController = require(script.Parent.ui.RaidController)
local GrowthController = require(script.Parent.ui.GrowthController)
local GoalController = require(script.Parent.ui.GoalController)
local CharacterController = require(script.Parent.ui.CharacterController)
local RaidMenuController = require(script.Parent.ui.RaidMenuController)
local StudioDebugController = require(script.Parent.ui.StudioDebugController)
local UiStyle = require(script.Parent.ui.UiStyle)

local UIController = {}

function UIController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("IdleRaidUI")
	if old then old:Destroy() end

	local gui = Instance.new("ScreenGui")
	gui.Name = "IdleRaidUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)

	HUDController.Start(gui, StateController)

	local autoButton = UiStyle.Button(gui, "AutoCombat", "AUTO 꺼짐",
		UDim2.fromOffset(100, 44), UDim2.new(1, -12, 0, 12))
	autoButton.AnchorPoint = Vector2.new(1, 0)
	autoButton.Activated:Connect(AutoCombatController.Toggle)
	AutoCombatController.OnChanged(function(enabled)
		autoButton.Text = if enabled then "AUTO 켜짐" else "AUTO 꺼짐"
		autoButton.BackgroundColor3 = if enabled then UiStyle.Colors.Accent else UiStyle.Colors.Surface
	end)

	local nav = Instance.new("Frame")
	nav.Name = "MenuNavigation"
	nav.BackgroundTransparency = 1
	nav.Size = UDim2.fromOffset(102, 216)
	nav.Position = UDim2.new(1, -114, 0, 64)
	nav.Parent = gui

	local container = Instance.new("Frame")
	container.Name = "MenuPanel"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromScale(0.5, 0.5)
	container.Size = UDim2.new(1, -24, 1, -72)
	container.BackgroundColor3 = UiStyle.Colors.Panel
	container.BorderSizePixel = 0
	container.Visible = false
	container.ZIndex = 10
	UiStyle.Panel(container, 12)
	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(520, 620)
	sizeLimit.MinSize = Vector2.new(280, 270)
	sizeLimit.Parent = container
	container.Parent = gui

	local pages = {}
	local pageDefs = {
		{ Key = "Character", Label = "캐릭터", Scrolling = true },
		{ Key = "Bag", Label = "가방", Scrolling = true },
		{ Key = "Growth", Label = "성장", Scrolling = false },
		{ Key = "Raid", Label = "레이드", Scrolling = true },
	}
	if RunService:IsStudio() then
		table.insert(pageDefs, { Key = "Debug", Label = "DEV", Scrolling = true })
	end
	for index, definition in ipairs(pageDefs) do
		local page = if definition.Scrolling then Instance.new("ScrollingFrame") else Instance.new("Frame")
		page.Name = definition.Key .. "Page"
		page.Size = UDim2.fromScale(1, 1)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.Visible = false
		page.ZIndex = 11
		if page:IsA("ScrollingFrame") then
			page.CanvasSize = UDim2.fromOffset(0, 590)
			page.ScrollBarThickness = 5
		end
		page.Parent = container
		pages[definition.Key] = page

		local button = UiStyle.Button(nav, definition.Key .. "Menu", definition.Label,
			UDim2.fromOffset(102, 48), UDim2.fromOffset(0, (index - 1) * 54))
		button.TextSize = 14
		button.Activated:Connect(function()
			local willOpen = not container.Visible or not page.Visible
			container.Visible = willOpen
			for key, item in pairs(pages) do item.Visible = willOpen and key == definition.Key end
		end)
	end

	local close = UiStyle.Button(container, "CloseMenu", "×", UDim2.fromOffset(42, 42),
		UDim2.new(1, -46, 0, 5))
	close.ZIndex = 15
	close.TextSize = 24
	close.Activated:Connect(function() container.Visible = false end)

	local function openPage(key)
		if not pages[key] then return end
		container.Visible = true
		for pageKey, page in pairs(pages) do page.Visible = pageKey == key end
	end
	CharacterController.Start(pages.Character, StateController)
	local selectItem = InventoryController.Start(pages.Bag, StateController)
	EquipmentController.Start(pages.Bag, StateController)
	GrowthController.Start(pages.Growth, StateController)
	RaidMenuController.Start(pages.Raid, StateController)
	if RunService:IsStudio() then StudioDebugController.Start(pages.Debug, StateController) end
	NotificationController.Start(gui, StateController, function(itemId)
		if selectItem(itemId) then openPage("Bag") end
	end, openPage)
	RaidController.Start(gui, StateController, DashController)
	GoalController.Start(gui, StateController, openPage, selectItem)

	local function resizeNavigation()
		local camera = Workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
		if viewport.Y < 480 then
			nav.Position = UDim2.new(1, -114, 0, 64)
			container.Size = UDim2.new(1, -24, 1, -35)
		else
			nav.Position = UDim2.new(1, -114, 0, 64)
			container.Size = UDim2.new(1, -24, 1, -72)
		end
	end
	resizeNavigation()
	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resizeNavigation)
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(resizeNavigation)

	ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("OpenGrowthMenu").OnClientEvent:Connect(function()
		container.Visible = true
		for key, page in pairs(pages) do page.Visible = key == "Growth" end
	end)
	StateController.Subscribe(function(state)
		local inRaid = state.Raid and state.Raid.IsParticipant == true
		if inRaid then container.Visible = false end
		nav.Visible = not inRaid
		autoButton.Visible = true
		local hud = gui:FindFirstChild("HUD")
		if hud then hud.Visible = not inRaid end
	end)
end

return UIController
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="38">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">CharacterController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)

local CharacterController = {}
local slots = { "Weapon", "Armor", "Accessory" }
local names = { Weapon = "무기", Armor = "방어구", Accessory = "장신구" }

function CharacterController.Start(panel: Frame, stateController)
	local title = UiStyle.Text(panel, "CharacterTitle", "캐릭터", UDim2.new(1, -20, 0, 32), UDim2.fromOffset(10, 10))
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 21
	title.TextColor3 = UiStyle.Colors.Gold
	local stats = UiStyle.Text(panel, "CharacterStats", "", UDim2.new(1, -20, 0, 150), UDim2.fromOffset(10, 50))
	stats.TextSize = 16
	stats.TextYAlignment = Enum.TextYAlignment.Top
	local gearTitle = UiStyle.Text(panel, "GearTitle", "착용 장비", UDim2.new(1, -20, 0, 28), UDim2.fromOffset(10, 220))
	gearTitle.Font = Enum.Font.GothamBold
	gearTitle.TextColor3 = UiStyle.Colors.Gold
	local gear = {}
	for index, slot in ipairs(slots) do
		gear[slot] = UiStyle.Text(panel, "Gear" .. slot, "", UDim2.new(1, -20, 0, 45),
			UDim2.fromOffset(10, 256 + (index - 1) * 51))
		gear[slot].TextSize = 15
	end
	local note = UiStyle.Text(panel, "CharacterNote", "가방 메뉴에서 장비를 장착·해제할 수 있습니다.",
		UDim2.new(1, -20, 0, 54), UDim2.fromOffset(10, 421))
	note.TextSize = 12
	note.TextColor3 = UiStyle.Colors.Muted

	stateController.Subscribe(function(state)
		stats.Text = string.format("레벨  %d\n기본 공격력  %s\n최종 공격력  %s\n최종 방어력  %s\n현재 수련 단계  %d",
			state.Level or 1, NumberFormatter.Format(state.BaseAttack or 0),
			NumberFormatter.Format(state.FinalAttack or 0), NumberFormatter.Format(state.FinalDefense or 0),
			state.BreakthroughStage or 1)
		for _, slot in ipairs(slots) do
			local itemId = (state.Equipment or {})[slot]
			local definition = itemId and ItemConfig.Items[itemId]
			gear[slot].Text = names[slot] .. "  " .. (definition and definition.Name or "없음")
			gear[slot].TextColor3 = if definition then UiStyle.Rarities[definition.Rarity] or UiStyle.Colors.Text
				else UiStyle.Colors.Muted
		end
	end)
end

return CharacterController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local UiStyle = require(script.Parent.UiStyle)

local EquipmentController = {}
local slots = { "Weapon", "Armor", "Accessory" }
local slotNames = { Weapon = "무기", Armor = "방어구", Accessory = "장신구" }

function EquipmentController.Start(panel: Frame, stateController)
	local section = Instance.new("Frame")
	section.Name = "Equipment"
	section.BackgroundTransparency = 1
	section.Size = UDim2.new(1, -16, 0, 170)
	section.Position = UDim2.fromOffset(8, 365)
	section.Parent = panel

	local title = UiStyle.Text(section, "Title", "착용 장비", UDim2.new(1, -16, 0, 25), UDim2.fromOffset(8, 0))
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = UiStyle.Colors.Gold

	local unequipRemote = ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("UnequipEquipment")
	local rows = {}

	for index, slot in ipairs(slots) do
		local slotName = slot
		local y = 27 + (index - 1) * 36
		local label = UiStyle.Text(section, slot, slotNames[slot] .. ": 없음", UDim2.new(1, -116, 0, 36), UDim2.fromOffset(8, y))
		label.TextSize = 14
		local button = UiStyle.Button(section, "Unequip" .. slot, "해제", UDim2.fromOffset(98, 36), UDim2.new(1, -106, 0, y))
		button.TextSize = 12
		button.Activated:Connect(function()
			unequipRemote:FireServer(slotName)
		end)
		rows[slot] = { Label = label, Button = button }
	end

	stateController.Subscribe(function(state)
		local equipment = state.Equipment or {}
		for _, slot in ipairs(slots) do
			local itemId = equipment[slot]
			local definition = itemId and ItemConfig.Items[itemId]
			rows[slot].Label.Text = slotNames[slot] .. ": " .. (definition and definition.Name or "없음")
			rows[slot].Label.TextColor3 = if definition then (UiStyle.Rarities[definition.Rarity] or UiStyle.Colors.Text)
				else UiStyle.Colors.Muted
			rows[slot].Button.Visible = definition ~= nil
		end
	end)
end

return EquipmentController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">GoalController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local AutoCombatController = require(script.Parent.Parent.AutoCombatController)
local UiStyle = require(script.Parent.UiStyle)

local GoalController = {}

function GoalController.Start(gui: ScreenGui, stateController, openPage, selectItem)
	local remotes = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local trainingRemote = remotes:WaitForChild("SetTrainingEnabled")
	local button = UiStyle.Button(gui, "NextGoal", "다음 목표 확인 중",
		UDim2.new(0.58, 0, 0, 52), UDim2.fromOffset(12, 198))
	button.TextSize = 13
	button.BackgroundColor3 = UiStyle.Colors.Panel
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(260, 52)
	limit.MinSize = Vector2.new(178, 52)
	limit.Parent = button
	local state
	local action
	local function update()
		if not state or not state.Ready then
			button.Text = "다음 목표 확인 중"
			button.Active = false
			return
		end
		button.Visible = not (state.Raid and state.Raid.IsParticipant)
		button.Active = true
		if not state.TrainingEnabled then
			button.Text = "다음 목표 · 기본 수련 시작"
			action = function() trainingRemote:FireServer(true) end
			return
		end
		local stage = state.BreakthroughStage or 1
		local gate = GrowthMath.NextGate(stage, state.ClearedRaidGates or {})
		if gate and stage >= gate.Stage then
			button.Text = "다음 목표 · " .. tostring(gate.Stage) .. "단계 관문 도전"
			action = function() openPage("Raid") end
			return
		end
		for _, stack in ipairs(state.Inventory or {}) do
			local definition = ItemConfig.Items[stack.ItemId]
			local wornId = definition and (state.Equipment or {})[definition.Type]
			local worn = wornId and ItemConfig.Items[wornId]
			local improves = definition and (not worn
				or (definition.Attack or 0) > (worn.Attack or 0)
				or (definition.Defense or 0) > (worn.Defense or 0))
			if improves then
				button.Text = "다음 목표 · 획득 장비 비교"
				action = function()
					if selectItem(stack.ItemId) then openPage("Bag") end
				end
				return
			end
		end
		local tier = state.TrainingFacilityTier or 1
		local facility = GrowthConfig.Facilities[tier + 1]
		if facility and (state.Gold or 0) >= facility.GoldCost
			and (not facility.RequiredGate or (state.ClearedRaidGates or {})[facility.RequiredGate]) then
			button.Text = "다음 목표 · Gold로 시설 개선"
			action = function() openPage("Growth") end
			return
		end
		if stage < GrowthConfig.MaxStage and GrowthMath.CanAdvance(stage, 1, state.ClearedRaidGates or {})
			and (state.AvailableTrainingPower or 0) >= (state.BreakthroughCost or math.huge) then
			button.Text = "다음 목표 · 무료 +1 돌파"
			action = function() openPage("Growth") end
			return
		end
		if not AutoCombatController.GetEnabled() then
			button.Text = "수련 중 · 눌러서 사냥 시작"
			action = AutoCombatController.Toggle
			return
		end
		button.Text = if stage >= GrowthConfig.MaxStage and not gate then "현재 관문 모두 클리어"
			else "수련·사냥으로 다음 성장 준비"
		action = function() openPage("Growth") end
	end
	button.Activated:Connect(function()
		if button.Active and action then action() end
	end)
	stateController.Subscribe(function(snapshot)
		state = snapshot
		update()
	end)
	AutoCombatController.OnChanged(update)
	return button
end

return GoalController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">GrowthController</string>
              <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local GrowthMath = require(ReplicatedStorage.Shared.GrowthMath)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)
local UiText = require(script.Parent.UiText)

local GrowthController = {}

local function label(parent, name, text, y, height)
	local result = UiStyle.Text(parent, name, text, UDim2.new(1, -20, 0, height), UDim2.fromOffset(10, y))
	result.TextSize = 14
	return result
end

local function button(parent, name, text, y)
	local result = UiStyle.Button(parent, name, text, UDim2.new(1, -20, 0, 44), UDim2.fromOffset(10, y))
	result.TextSize = 14
	return result
end

function GrowthController.Start(panel: Frame, stateController)
	local remote = ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("GrowthAction")
	local trainingRemote = ReplicatedStorage.IdleRaidRemotes:WaitForChild("SetTrainingEnabled")
	local tabNames = { "돌파", "시설", "수련권" }
	local tabs = {}
	local views = {}
	local currentState
	local selectedPreview
	local busy = false

	local title = label(panel, "Title", "성장", 8, 26)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 20
	title.TextColor3 = UiStyle.Colors.Gold
	local feedback = label(panel, "Feedback", "", 36, 28)
	feedback.TextColor3 = UiStyle.Colors.Accent
	feedback.TextSize = 12

	for index, name in ipairs(tabNames) do
		local tab = UiStyle.Button(panel, "Tab" .. index, name,
			UDim2.new(1 / 3, -8, 0, 42), UDim2.new((index - 1) / 3, 6, 0, 67))
		tabs[index] = tab
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "Growth" .. index
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 5
		scroll.Size = UDim2.new(1, -10, 1, -116)
		scroll.Position = UDim2.fromOffset(5, 112)
		scroll.CanvasSize = UDim2.fromOffset(0, 640)
		scroll.Visible = index == 1
		scroll.Parent = panel
		views[index] = scroll
		tab.Activated:Connect(function()
			for viewIndex, view in ipairs(views) do
				view.Visible = viewIndex == index
				tabs[viewIndex].BackgroundColor3 = if viewIndex == index then UiStyle.Colors.Accent else UiStyle.Colors.Surface
			end
			selectedPreview = nil
		end)
	end
	tabs[1].BackgroundColor3 = UiStyle.Colors.Accent

	local stageLine = label(views[1], "Stage", "돌파 1단계", 4, 22)
	local availableLine = label(views[1], "Available", "사용 가능 수련력 --", 29, 27)
	availableLine.TextColor3 = UiStyle.Colors.Gold
	local costLine = label(views[1], "Cost", "다음 돌파 비용 --", 60, 22)
	local gateLine = label(views[1], "Gate", "다음 관문 --", 86, 22)
	local previewLine = label(views[1], "Preview", "돌파 방법을 선택하세요", 113, 74)
	previewLine.TextWrapped = true
	previewLine.TextColor3 = UiStyle.Colors.Accent
	local stepButtons = {}
	for index, steps in ipairs({ 1, 2, 3, 5 }) do
		local row = button(views[1], "Step" .. steps, if steps == 1 then "무료 +1" else "+" .. steps .. "권 사용", 195 + (index - 1) * 49)
		stepButtons[steps] = row
	end
	local confirm = button(views[1], "ConfirmBreakthrough", "돌파 확정", 400)
	confirm.Visible = false
	local purchaseNote = label(views[1], "ProductNote",
		"추가 구매: 준비 중 · 가격 및 상품 ID 미설정\n돌파권은 앞으로의 수련 단계만 올립니다. 관문은 직접 클리어해야 합니다.", 451, 70)
	purchaseNote.TextSize = 12
	purchaseNote.TextColor3 = UiStyle.Colors.Muted

	local facilityLine = label(views[2], "Facility", "현재 시설 1단계", 9, 30)
	facilityLine.TextColor3 = UiStyle.Colors.Gold
	local facilityNext = label(views[2], "FacilityNext", "", 49, 85)
	local facilityBuy = button(views[2], "FacilityBuy", "Gold로 시설 업그레이드", 142)
	local trainingToggle = button(views[2], "TrainingToggle", "기본 수련 켜기/끄기", 198)
	local facilityNote = label(views[2], "FacilityNote",
		"시설은 Gold로 개선합니다. 상위 등급이 하위 효과를 대체합니다.\n시설권 상품은 미정 · 판매 비활성", 254, 70)
	facilityNote.TextColor3 = UiStyle.Colors.Muted

	local voucherIntro = label(views[3], "VoucherIntro",
		"수련권은 현재 기본 획득량/초를 기준으로 즉시 수련력을 줍니다.\n돌파나 관문 클리어를 자동으로 하지 않습니다.", 7, 65)
	local voucherButtons = {}
	for index, voucherId in ipairs({ "Minutes10", "Minutes30", "Minutes120" }) do
		voucherButtons[voucherId] = button(views[3], voucherId, GrowthConfig.Vouchers[voucherId].Label, 82 + (index - 1) * 54)
	end
	local voucherPreview = label(views[3], "VoucherPreview", "수련권을 선택하세요", 257, 72)
	voucherPreview.TextColor3 = UiStyle.Colors.Accent
	local voucherConfirm = button(views[3], "VoucherConfirm", "수련권 사용 확정", 335)
	voucherConfirm.Visible = false
	local voucherProduct = label(views[3], "VoucherProduct",
		"추가 구매: 준비 중 · 가격 및 상품 ID 미설정\n보유한 수련권은 조건이 맞을 때 사용할 수 있습니다.", 390, 64)
	voucherProduct.TextSize = 12
	voucherProduct.TextColor3 = UiStyle.Colors.Muted

	local function invoke(action, payload)
		local ok, result = pcall(function() return remote:InvokeServer(action, payload) end)
		if not ok or typeof(result) ~= "table" then
			feedback.Text = "서버 응답을 확인하지 못했습니다"
			return nil
		end
		if not result.Ok then
			feedback.Text = UiText.Reason(result.Reason)
		else
			feedback.Text = UiText.Ready
		end
		return result
	end

	for steps, row in pairs(stepButtons) do
		row.Activated:Connect(function()
			if busy or not currentState or not currentState.Ready then return end
			busy = true
			local result = invoke("PreviewBreakthrough", { Steps = steps })
			busy = false
			if not result then return end
			if not result.Ok then
				selectedPreview = nil
				confirm.Visible = false
				previewLine.Text = string.format("%d단계 → %s · 비용 %s / 보유 %s\n%s",
					result.Stage or 1, result.TargetStage and tostring(result.TargetStage) or "이동 불가",
					NumberFormatter.Format(result.Cost or 0), NumberFormatter.Format(result.AvailablePower or 0),
					UiText.Reason(result.Reason))
				return
			end
			selectedPreview = { Kind = "Breakthrough", Steps = steps, Stage = result.Stage }
			previewLine.Text = string.format("%d → %d단계  |  배수 x%s → x%s\n기본 수련 %s → %s/초\n수련력 %s / 보유 %s · 다음 관문 %s",
				result.Stage, result.TargetStage, NumberFormatter.Format(result.CurrentMultiplier),
				NumberFormatter.Format(result.TargetMultiplier), NumberFormatter.Format(result.CurrentRate),
				NumberFormatter.Format(result.TargetRate), NumberFormatter.Format(result.Cost),
				NumberFormatter.Format(result.AvailablePower), result.NextGate and result.NextGate.Stage or "완료")
			confirm.Visible = true
		end)
	end
	confirm.Activated:Connect(function()
		if busy or not selectedPreview or selectedPreview.Kind ~= "Breakthrough" then return end
		busy = true
		local result = invoke("Breakthrough", {
			Steps = selectedPreview.Steps, ExpectedStage = selectedPreview.Stage,
			RequestId = HttpService:GenerateGUID(false),
		})
		busy = false
		selectedPreview = nil
		confirm.Visible = false
		if result and result.Ok then
			feedback.Text = string.format("%d단계 돌파 성공", result.Stage)
			previewLine.Text = "다음 돌파 방법을 선택하세요"
		end
	end)

	facilityBuy.Activated:Connect(function()
		if busy or not currentState or not currentState.Ready then return end
		busy = true
		local result = invoke("UpgradeFacility", {
			ExpectedTier = currentState.TrainingFacilityTier,
			RequestId = HttpService:GenerateGUID(false),
		})
		busy = false
		if result and result.Ok then feedback.Text = string.format("시설 %d단계 해금", result.Tier) end
	end)
	trainingToggle.Activated:Connect(function()
		if currentState and currentState.Ready then
			trainingRemote:FireServer(not currentState.TrainingEnabled)
		end
	end)

	for voucherId, row in pairs(voucherButtons) do
		row.Activated:Connect(function()
			if busy or not currentState or not currentState.Ready then return end
			busy = true
			local result = invoke("PreviewVoucher", { VoucherId = voucherId })
			busy = false
			if not result or not result.Ok then
				selectedPreview = nil
				voucherConfirm.Visible = false
				voucherPreview.Text = result and UiText.Reason(result.Reason) or "미리보기를 확인할 수 없습니다"
				return
			end
			selectedPreview = { Kind = "Voucher", Id = voucherId, Rate = result.Rate, Count = result.Count }
			voucherPreview.Text = string.format("%s 보유 %d장\n현재 기본 수련 %s/초 × %d초 = +%s 수련력",
				GrowthConfig.Vouchers[voucherId].Label, result.Count, NumberFormatter.Format(result.Rate),
				GrowthConfig.Vouchers[voucherId].Seconds, NumberFormatter.Format(result.Grant))
			voucherConfirm.Visible = true
		end)
	end
	voucherConfirm.Activated:Connect(function()
		if busy or not selectedPreview or selectedPreview.Kind ~= "Voucher" then return end
		busy = true
		local result = invoke("UseVoucher", {
			VoucherId = selectedPreview.Id, ExpectedRate = selectedPreview.Rate,
			ExpectedCount = selectedPreview.Count, RequestId = HttpService:GenerateGUID(false),
		})
		busy = false
		selectedPreview = nil
		voucherConfirm.Visible = false
		if result and result.Ok then
			feedback.Text = "+" .. NumberFormatter.Format(result.GrantedPower) .. " 수련력"
			voucherPreview.Text = "다음 수련권을 선택하세요"
		end
	end)

	stateController.Subscribe(function(state)
		currentState = state
		if not state.Ready then
			feedback.Text = UiText.Loading
			return
		end
		local stage = state.BreakthroughStage or 1
		stageLine.Text = string.format("현재 %d단계 · 배수 x%s · 기본 %s/초", stage,
			NumberFormatter.Format(state.StageMultiplier or 1), NumberFormatter.Format(state.BaseTrainingRate or 0))
		availableLine.Text = "사용 가능 수련력  " .. NumberFormatter.Format(state.AvailableTrainingPower or 0)
		costLine.Text = if state.BreakthroughCost then "다음 돌파 비용  " .. NumberFormatter.Format(state.BreakthroughCost)
			else "최고 단계"
		local nextGate = GrowthMath.NextGate(stage, state.ClearedRaidGates or {})
		gateLine.Text = if nextGate then string.format("다음 미클리어 관문: %d단계", nextGate.Stage)
			else "모든 관문 클리어"
		for steps, row in pairs(stepButtons) do
			local count = (state.BreakthroughTickets or {})[tostring(steps)] or 0
			row.Text = if steps == 1 then "무료 +1단계" else string.format("+%d단계권 사용 · %d장", steps, count)
		end
		local tier = state.TrainingFacilityTier or 1
		local facility = GrowthConfig.Facilities[tier]
		local nextFacility = GrowthConfig.Facilities[tier + 1]
		facilityLine.Text = string.format("현재 수련 시설 %d등급 · x%.1f", tier,
			facility.Numerator / facility.Denominator)
		if nextFacility then
			local beforeRate = GrowthMath.BaseRate(stage, tier)
			local afterRate = GrowthMath.BaseRate(stage, tier + 1)
			local hasGate = not nextFacility.RequiredGate
				or (state.ClearedRaidGates or {})[nextFacility.RequiredGate] == true
			local affordable = (state.Gold or 0) >= nextFacility.GoldCost
			facilityNext.Text = string.format("현재 %s/초 → 적용 후 %s/초\nGold 비용 %s / 보유 %s\n%s",
				NumberFormatter.Format(beforeRate), NumberFormatter.Format(afterRate),
				NumberFormatter.Format(nextFacility.GoldCost), NumberFormatter.Format(state.Gold or 0),
				if not hasGate then "선행 " .. nextFacility.RequiredGate .. " 클리어 필요"
				elseif not affordable then "Gold 부족" else "업그레이드 가능")
			facilityBuy.Text = string.format("Gold로 %d등급 개선", tier + 1)
			facilityBuy.Active = hasGate and affordable
			facilityBuy.BackgroundColor3 = if hasGate and affordable then UiStyle.Colors.Accent else UiStyle.Colors.Surface
			facilityBuy.Visible = true
		else
			facilityNext.Text = "최고 시설 등급"
			facilityBuy.Visible = false
		end
		trainingToggle.Text = if state.TrainingEnabled then "기본 자동수련: 켜짐" else "기본 자동수련: 꺼짐"
		for voucherId, row in pairs(voucherButtons) do
			row.Text = string.format("%s · 보유 %d장", GrowthConfig.Vouchers[voucherId].Label,
				(state.TrainingVouchers or {})[voucherId] or 0)
		end
	end)
end

return GrowthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)
local UiText = require(script.Parent.UiText)

local HUDController = {}

function HUDController.Start(gui: ScreenGui, stateController)
	local panel = Instance.new("Frame")
	panel.Name = "HUD"
	panel.BackgroundColor3 = UiStyle.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Size = UDim2.new(0.58, 0, 0, 178)
	panel.Position = UDim2.fromOffset(12, 12)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(260, 178)
	limit.MinSize = Vector2.new(178, 178)
	limit.Parent = panel
	UiStyle.Panel(panel, 12)
	panel.Parent = gui

	local lifetimeCaption = UiStyle.Text(panel, "LifetimeCaption", UiText.Lifetime, UDim2.new(1, -20, 0, 20), UDim2.fromOffset(12, 7))
	lifetimeCaption.TextSize = 13
	lifetimeCaption.TextColor3 = UiStyle.Colors.Muted
	local lifetime = UiStyle.Text(panel, "LifetimePower", "--", UDim2.new(1, -20, 0, 32), UDim2.fromOffset(12, 26))
	lifetime.TextSize = 26
	lifetime.Font = Enum.Font.GothamBlack
	lifetime.TextColor3 = UiStyle.Colors.Gold

	local level = UiStyle.Text(panel, "Level", "레벨 1", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(12, 63))
	level.TextSize = 15
	local exp = UiStyle.Text(panel, "Exp", "0 / 100", UDim2.new(1, -20, 0, 18), UDim2.fromOffset(12, 83))
	exp.TextSize = 12
	exp.TextColor3 = UiStyle.Colors.Muted
	local bar = Instance.new("Frame")
	bar.Name = "ExpBar"
	bar.BackgroundColor3 = UiStyle.Colors.Surface
	bar.BorderSizePixel = 0
	bar.Size = UDim2.new(1, -24, 0, 9)
	bar.Position = UDim2.fromOffset(12, 105)
	UiStyle.Corner(bar, 5)
	bar.Parent = panel
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = UiStyle.Colors.Accent
	fill.BorderSizePixel = 0
	UiStyle.Corner(fill, 5)
	fill.Parent = bar

	local stage = UiStyle.Text(panel, "Stage", "돌파 1단계", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(12, 119))
	stage.TextSize = 14
	local rate = UiStyle.Text(panel, "Rate", "x1 · 10/초", UDim2.new(1, -20, 0, 19), UDim2.fromOffset(12, 138))
	rate.TextSize = 13
	rate.TextColor3 = UiStyle.Colors.Accent
	local gold = UiStyle.Text(panel, "Gold", "Gold 0", UDim2.new(1, -20, 0, 16), UDim2.fromOffset(12, 157))
	gold.TextSize = 12
	gold.TextColor3 = UiStyle.Colors.Muted

	stateController.Subscribe(function(state)
		if not state.Ready then
			lifetime.Text = "--"
			level.Text = UiText.Loading
			return
		end
		lifetime.Text = NumberFormatter.Format(state.LifetimeTrainingPower or 0)
		level.Text = string.format("레벨 %d", state.Level or 1)
		local required = state.ExpRequired or 0
		exp.Text = if required > 0 then string.format("%s / %s", NumberFormatter.Format(state.Exp or 0),
			NumberFormatter.Format(required)) else "최고 레벨"
		fill.Size = UDim2.fromScale(if required > 0 then math.clamp((state.Exp or 0) / required, 0, 1) else 1, 1)
		stage.Text = string.format("돌파 %d단계", state.BreakthroughStage or 1)
		rate.Text = string.format("x%s · %s/초", NumberFormatter.Format(state.StageMultiplier or 1),
			NumberFormatter.Format(state.BaseTrainingRate or 0))
		gold.Text = "Gold " .. NumberFormatter.Format(state.Gold or 0)
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)

local InventoryController = {}
local typeNames = { Weapon = "무기", Armor = "방어구", Accessory = "장신구" }
local rarityNames = { Common = "일반", Uncommon = "고급", Rare = "희귀", Epic = "영웅", Legendary = "전설" }

function InventoryController.Start(panel: Frame, stateController)
	local section = Instance.new("Frame")
	section.Name = "Inventory"
	section.BackgroundTransparency = 1
	section.Size = UDim2.new(1, -16, 0, 350)
	section.Position = UDim2.fromOffset(8, 8)
	section.Parent = panel

	local title = UiStyle.Text(section, "Title", "가방", UDim2.new(1, -16, 0, 25), UDim2.fromOffset(8, 0))
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = UiStyle.Colors.Gold

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Items"
	scroll.BackgroundColor3 = UiStyle.Colors.Surface
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Size = UDim2.new(1, -16, 1, -140)
	scroll.Position = UDim2.fromOffset(8, 29)
	UiStyle.Corner(scroll, 8)
	scroll.Parent = section

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
	end)

	local selectedLabel = UiStyle.Text(section, "Selected", "아이템을 선택하세요", UDim2.new(1, -16, 0, 58), UDim2.new(0, 8, 1, -108))
	selectedLabel.TextSize = 12
	local equipButton = UiStyle.Button(section, "Equip", "장착", UDim2.new(1, -16, 0, 42), UDim2.new(0, 8, 1, -46))
	equipButton.Visible = false

	local equipRemote = ReplicatedStorage:WaitForChild("IdleRaidRemotes"):WaitForChild("EquipItem")
	local selectedItemId
	local currentState
	local lastInventory
	local lastEquipment
	local lastAttack
	local lastDefense
	local hasRendered = false

	local function render(state, force)
		currentState = state
		if hasRendered and not force and state.Inventory == lastInventory and state.Equipment == lastEquipment
		and state.FinalAttack == lastAttack and state.FinalDefense == lastDefense then return end
		hasRendered = true
		lastInventory = state.Inventory
		lastEquipment = state.Equipment
		lastAttack = state.FinalAttack
		lastDefense = state.FinalDefense
		local selectedStack
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local items = state.Inventory or {}
		for _, stack in ipairs(items) do
			local itemId = stack.ItemId
			local definition = ItemConfig.Items[itemId]
			if definition then
				if selectedItemId == stack.ItemId then
					selectedStack = stack
				end
				local prefix = if selectedItemId == stack.ItemId then "● " else ""
				local row = UiStyle.Button(
					scroll,
					stack.ItemId,
					string.format("%s%s  x%d\n%s · %s", prefix, definition.Name, stack.Quantity, typeNames[definition.Type] or definition.Type, rarityNames[definition.Rarity] or definition.Rarity),
					UDim2.new(1, -10, 0, 56),
					UDim2.fromOffset(4, 0)
				)
				row.TextXAlignment = Enum.TextXAlignment.Left
				row.TextSize = 14
				local rarityColor = UiStyle.Rarities[definition.Rarity] or UiStyle.Colors.Text
				row.TextColor3 = rarityColor
				row.BackgroundColor3 = if selectedItemId == itemId then Color3.fromRGB(54, 82, 113)
					else UiStyle.Colors.Surface
				local outline = row:FindFirstChild("Outline")
				if outline and outline:IsA("UIStroke") then
					outline.Color = rarityColor
					outline.Transparency = 0.55
				end
				row.LayoutOrder = #scroll:GetChildren()
				row.Activated:Connect(function()
					selectedItemId = itemId
					render(currentState, true)
				end)
			end
		end

		if selectedStack then
			equipButton.Visible = true
			local selected = ItemConfig.Items[selectedItemId]
			local wornId = (state.Equipment or {})[selected.Type]
			local worn = wornId and ItemConfig.Items[wornId]
			local beforeAttack = state.FinalAttack or 0
			local beforeDefense = state.FinalDefense or 0
			local afterAttack = beforeAttack - (worn and worn.Attack or 0) + (selected.Attack or 0)
			local afterDefense = beforeDefense - (worn and worn.Defense or 0) + (selected.Defense or 0)
			selectedLabel.Text = string.format("%s → %s\n공격 %s → %s  ·  방어 %s → %s",
				worn and worn.Name or "미착용", selected.Name,
				NumberFormatter.Format(beforeAttack), NumberFormatter.Format(afterAttack),
				NumberFormatter.Format(beforeDefense), NumberFormatter.Format(afterDefense))
			equipButton.Active = true
			equipButton.AutoButtonColor = true
			equipButton.BackgroundColor3 = UiStyle.Colors.Accent
		else
			equipButton.Visible = false
			selectedItemId = nil
			selectedLabel.Text = if #items == 0 then "아직 아이템 없음" else "아이템을 선택하세요"
			equipButton.Active = false
			equipButton.AutoButtonColor = false
			equipButton.BackgroundColor3 = UiStyle.Colors.Surface
		end
	end

	equipButton.Activated:Connect(function()
		if selectedItemId then
			equipRemote:FireServer(selectedItemId)
		end
	end)
	stateController.Subscribe(render)
	return function(itemId: string): boolean
		if not currentState then return false end
		for _, stack in ipairs(currentState.Inventory or {}) do
			if stack.ItemId == itemId then
				selectedItemId = itemId
				render(currentState, true)
				task.defer(function()
					local row = scroll:FindFirstChild(itemId)
					if row then
						scroll.CanvasPosition = Vector2.new(0, math.max(0,
							row.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y))
					end
				end)
				return true
			end
		end
		return false
	end
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ItemConfig = require(ReplicatedStorage.Shared.ItemConfig)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)

local NotificationController = {}

function NotificationController.Start(gui: ScreenGui, stateController, openItem, openPage)
	local toast = UiStyle.Button(gui, "GrowthNotice", "", UDim2.new(1, -24, 0, 42), UDim2.new(0.5, 0, 0, 0))
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.BackgroundColor3 = UiStyle.Colors.Accent
	toast.Font = Enum.Font.GothamBlack
	toast.TextSize = 13
	toast.Visible = false
	toast.ZIndex = 20
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(320, 42)
	limit.Parent = toast

	local queue = {}
	local displaying = false
	local currentAction
	local function pump()
		if displaying or #queue == 0 then return end
		displaying = true
		task.spawn(function()
			while #queue > 0 and gui.Parent do
				local entry = table.remove(queue, 1)
				currentAction = entry.Action
				toast.Active = entry.Action ~= nil
				toast.Text = entry.Text
				toast.BackgroundColor3 = entry.Color
				toast.Visible = true
				task.wait(entry.Duration or 2.4)
				toast.Visible = false
				currentAction = nil
			end
			displaying = false
		end)
	end
	local function enqueue(message, color, action, duration)
		if #queue >= 5 then
			local removable
			for index, entry in ipairs(queue) do
				if not entry.Action then removable = index break end
			end
			if not removable and not action then return end
			table.remove(queue, removable or 1)
		end
		table.insert(queue, { Text = message, Color = color, Action = action, Duration = duration })
		pump()
	end
	toast.Activated:Connect(function()
		if currentAction then currentAction() end
	end)

	local pendingPower = 0
	local pendingGold = 0
	local rewardScheduled = false
	local function flushRewards()
		if pendingPower > 0 or pendingGold > 0 then
			local parts = {}
			if pendingPower > 0 then table.insert(parts, "수련력 +" .. NumberFormatter.Format(pendingPower)) end
			if pendingGold > 0 then table.insert(parts, "Gold +" .. NumberFormatter.Format(pendingGold)) end
			enqueue(table.concat(parts, " · "), UiStyle.Colors.Accent)
		end
		pendingPower, pendingGold = 0, 0
		rewardScheduled = false
	end
	local function scheduleRewards()
		if rewardScheduled then return end
		rewardScheduled = true
		task.delay(2.5, flushRewards)
	end

	local offlinePanel = Instance.new("Frame")
	offlinePanel.Name = "OfflineSummary"
	offlinePanel.Size = UDim2.new(1, -24, 0, 210)
	offlinePanel.Position = UDim2.fromScale(0.5, 0.5)
	offlinePanel.AnchorPoint = Vector2.new(0.5, 0.5)
	offlinePanel.BackgroundColor3 = UiStyle.Colors.Panel
	offlinePanel.BorderSizePixel = 0
	offlinePanel.Visible = false
	offlinePanel.ZIndex = 30
	UiStyle.Panel(offlinePanel, 12)
	local offlineLimit = Instance.new("UISizeConstraint")
	offlineLimit.MaxSize = Vector2.new(400, 210)
	offlineLimit.Parent = offlinePanel
	offlinePanel.Parent = gui
	local offlineText = UiStyle.Text(offlinePanel, "Summary", "", UDim2.new(1, -20, 0, 146), UDim2.fromOffset(10, 9))
	offlineText.TextSize = 14
	offlineText.ZIndex = 31
	local dismiss = UiStyle.Button(offlinePanel, "Dismiss", "확인", UDim2.new(1, -20, 0, 42), UDim2.fromOffset(10, 159))
	dismiss.ZIndex = 31
	dismiss.Activated:Connect(function() offlinePanel.Visible = false end)

	stateController.OnNotification(function(notification)
		local kind = notification.Kind
		if kind == "Power" and notification.Source ~= "RaidClear" then
			pendingPower += notification.Amount or 0
			scheduleRewards()
		elseif kind == "Gold" and notification.Source ~= "RaidClear" then
			pendingGold += notification.Amount or 0
			scheduleRewards()
		elseif kind == "Item" then
			local definition = ItemConfig.Items[notification.ItemId]
			if definition then
				enqueue("획득: " .. definition.Name .. " · 눌러서 비교",
					UiStyle.Rarities[definition.Rarity] or UiStyle.Colors.Accent,
					function() openItem(notification.ItemId) end, 3.2)
			end
		elseif kind == "Equipment" then
			local definition = notification.ItemId and ItemConfig.Items[notification.ItemId]
			local label = if notification.Action == "Equip" and definition then definition.Name .. " 장착"
				else tostring(notification.Slot or "장비") .. " 해제"
			enqueue(label, UiStyle.Colors.Accent, function() openPage("Bag") end)
		elseif kind == "Offline" then
			local summary = notification.Summary
			if typeof(summary) == "table" and (summary.GrantedPower or 0) > 0 then
				offlineText.Text = string.format("오프라인 수련\n실제 경과 %d분 · 인정 %d분\n기준 수련 %s/초 · 효율 %d%%\n받은 수련력 +%s\n레벨 %d → %d",
					math.floor((summary.ElapsedSeconds or 0) / 60),
					math.floor((summary.AcceptedSeconds or 0) / 60),
					NumberFormatter.Format(summary.Rate or 0),
					math.floor(100 * (summary.EfficiencyNumerator or 0) / math.max(1, summary.EfficiencyDenominator or 1)),
					NumberFormatter.Format(summary.GrantedPower),
					summary.LevelBefore or 1, summary.LevelAfter or 1)
				offlinePanel.Visible = true
			end
		elseif kind == "Breakthrough" then
			enqueue(string.format("돌파 %d → %d · 수련 %s/초", notification.From or 1,
				notification.To or 1, NumberFormatter.Format(notification.AfterRate or 0)),
				UiStyle.Colors.Gold, function() openPage("Growth") end)
		elseif kind == "Facility" then
			enqueue(string.format("시설 %d등급 · 수련 %s → %s/초", notification.Tier or 1,
				NumberFormatter.Format(notification.BeforeRate or 0),
				NumberFormatter.Format(notification.AfterRate or 0)),
				UiStyle.Colors.Accent, function() openPage("Growth") end)
		elseif kind == "GateClear" then
			enqueue("관문 클리어: " .. tostring(notification.GateId or ""), UiStyle.Colors.Gold,
				function() openPage("Raid") end)
		elseif kind == "RaidReward" then
			enqueue(string.format("레이드 보상 · 수련력 +%s · Gold +%s · Token +%s",
				NumberFormatter.Format(notification.Power or 0),
				NumberFormatter.Format(notification.Gold or 0),
				NumberFormatter.Format(notification.Tokens or 0)),
				UiStyle.Colors.Gold, function() openPage("Raid") end, 4)
		elseif kind == "Voucher" then
			enqueue("수련권 사용 · 수련력 +" .. NumberFormatter.Format(notification.Amount or 0),
				UiStyle.Colors.Accent)
		end
	end)

	local lastLevel
	stateController.Subscribe(function(state)
		if not state.Ready then return end
		local level = state.Level or 1
		if lastLevel and level > lastLevel then
			enqueue(string.format("LEVEL UP!  Lv.%d", level), UiStyle.Colors.Gold, nil, 3)
		end
		lastLevel = level
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">RaidController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local UiStyle = require(script.Parent.UiStyle)

local RaidController = {}

local function makeMarker(kind: string, first: Vector3, second, third, lifetime: number)
	local marker = Instance.new("Part")
	marker.Name = "RaidTelegraph"
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanTouch = false
	marker.CanQuery = false
	marker.Material = Enum.Material.Neon
	marker.Transparency = 0.3
	if kind == "Slam" then
		local radius = second
		marker.Color = Color3.fromRGB(255, 155, 45)
		marker.Shape = Enum.PartType.Cylinder
		marker.Size = Vector3.new(0.16, radius * 2, radius * 2)
		marker.CFrame = CFrame.new(first + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	elseif kind == "Charge" then
		local destination = second
		local width = third
		local flatFirst = Vector3.new(first.X, GameConfig.Raid.ArenaCenter.Y + 0.12, first.Z)
		local flatEnd = Vector3.new(destination.X, GameConfig.Raid.ArenaCenter.Y + 0.12, destination.Z)
		marker.Color = Color3.fromRGB(200, 80, 250)
		marker.Size = Vector3.new(width, 0.16, (flatEnd - flatFirst).Magnitude)
		marker.CFrame = CFrame.lookAt((flatFirst + flatEnd) / 2, flatEnd)
	else
		marker:Destroy()
		return
	end
	marker.Parent = Workspace
	task.delay(math.max(0, lifetime - GameConfig.Raid.WarningFlashTime), function()
		if marker.Parent then
			marker.Color = Color3.fromRGB(255, 35, 35)
			marker.Transparency = 0.05
		end
	end)
	task.delay(lifetime, function() marker:Destroy() end)
end

local function makeBar(parent: Instance, name: string, position: UDim2, color: Color3)
	local bar = Instance.new("Frame")
	bar.Name = name
	bar.Size = UDim2.new(1, -20, 0, 12)
	bar.Position = position
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = UiStyle.Colors.Surface
	UiStyle.Corner(bar, 6)
	bar.Parent = parent
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = color
	UiStyle.Corner(fill, 6)
	fill.Parent = bar
	return fill
end

local function makeFeedback(gui: ScreenGui, name: string, position: UDim2, color: Color3)
	local label = UiStyle.Text(gui, name, "", UDim2.new(1, -24, 0, 42), position)
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 27
	label.TextColor3 = color
	label.Visible = false
	return label
end

function RaidController.Start(gui: ScreenGui, stateController, dashController)
	local remotes = ReplicatedStorage:WaitForChild("IdleRaidRemotes")

	local dashButton = UiStyle.Button(gui, "DashButton", "DASH Q", UDim2.fromOffset(108, 56), UDim2.new(1, -12, 1, -80))
	dashButton.AnchorPoint = Vector2.new(1, 0)
	dashButton.Visible = false
	dashButton.Activated:Connect(dashController.Request)

	local panel = Instance.new("Frame")
	panel.Name = "RaidPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0)
	panel.Position = UDim2.new(0.5, 0, 0, 70)
	panel.Size = UDim2.new(1, -24, 0, 160)
	panel.BackgroundColor3 = UiStyle.Colors.Panel
	panel.BorderSizePixel = 0
	panel.Visible = false
	UiStyle.Panel(panel, 12)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(420, 160)
	limit.Parent = panel
	panel.Parent = gui

	local title = UiStyle.Text(panel, "BossName", "Slime King", UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 6))
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = UiStyle.Colors.Gold
	title.TextXAlignment = Enum.TextXAlignment.Center
	local bossHp = UiStyle.Text(panel, "BossHealth", "HP -- / --", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 30))
	bossHp.TextXAlignment = Enum.TextXAlignment.Center
	local bossFill = makeBar(panel, "BossBar", UDim2.fromOffset(10, 51), Color3.fromRGB(224, 78, 78))
	local health = UiStyle.Text(panel, "PlayerHealth", "Health: 100 / 100", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 72))
	local healthFill = makeBar(panel, "HealthBar", UDim2.fromOffset(10, 95), UiStyle.Colors.Accent)
	local status = UiStyle.Text(panel, "RaidStatus", "Gathering", UDim2.new(0.5, -10, 0, 24), UDim2.fromOffset(10, 120))
	local cooldown = UiStyle.Text(panel, "DashCooldown", "Dash: Ready", UDim2.new(0.5, -10, 0, 24), UDim2.new(0.5, 0, 0, 120))
	cooldown.TextXAlignment = Enum.TextXAlignment.Right

	local warning = makeFeedback(gui, "RaidWarning", UDim2.new(0.5, 0, 0, 238), Color3.fromRGB(255, 145, 65))
	local taken = makeFeedback(gui, "TakenDamage", UDim2.new(0.5, 0, 0.62, 0), Color3.fromRGB(255, 70, 70))
	local dealt = makeFeedback(gui, "BossDamage", UDim2.new(0.5, 0, 0, 366), Color3.fromRGB(255, 235, 120))
	local result = makeFeedback(gui, "RaidResult", UDim2.new(0.5, 0, 0.5, -30), UiStyle.Colors.Text)
	result.TextSize = 32
	result.Size = UDim2.new(1, -24, 0, 60)

	local lastMembership
	local dashReadyAt = 0
	local active = false
	local defeated = false
	stateController.Subscribe(function(state)
		local raid = state.Raid or {}
		dashButton.Visible = raid.IsParticipant == true
		if lastMembership ~= raid.IsParticipant then
			lastMembership = raid.IsParticipant
			pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, not raid.IsParticipant)
			end)
		end
		panel.Visible = raid.IsParticipant == true
		result.Visible = raid.IsParticipant and (raid.Status == "Clear" or raid.Status == "Failed") or false
		active = raid.Status == "Active"
		defeated = raid.Defeated == true
		dashReadyAt = raid.DashReadyAt or 0
		if not raid.IsParticipant then
			warning.Visible = false
			return
		end
		title.Text = raid.BossName or "Slime King"
		local maxHp = raid.BossMaxHealth or 0
		local hp = raid.BossHealth or 0
		bossHp.Text = string.format("HP %d / %d", hp, maxHp)
		bossFill.Size = UDim2.fromScale(if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0, 1)
		local maxHealth = math.max(1, state.MaxHealth or 100)
		local currentHealth = state.Health or 0
		health.Text = string.format("Health: %d / %d", currentHealth, maxHealth)
		local ratio = math.clamp(currentHealth / maxHealth, 0, 1)
		healthFill.Size = UDim2.fromScale(ratio, 1)
		healthFill.BackgroundColor3 = if ratio <= 0.3 then Color3.fromRGB(230, 70, 70)
			elseif ratio <= 0.6 then Color3.fromRGB(235, 180, 55) else UiStyle.Colors.Accent
		status.Text = if defeated then "Defeated" elseif raid.Phase == "Recovery" then "Boss recovering"
			else raid.Phase or raid.Status
		if raid.Status == "Clear" then
			result.Text = "RAID CLEAR"
		elseif raid.Status == "Failed" then
			result.Text = "RAID FAILED"
		end
	end)

	task.spawn(function()
		while gui.Parent do
			local remaining = math.max(0, dashReadyAt - Workspace:GetServerTimeNow())
			local ready = active and not defeated and remaining <= 0
			dashButton.Active = ready
			dashButton.BackgroundColor3 = if ready then UiStyle.Colors.Accent else UiStyle.Colors.Surface
			dashButton.Text = if remaining > 0 then string.format("DASH %.1f", remaining) else "DASH Q"
			cooldown.Text = if remaining > 0 then string.format("Dash: %.1fs", remaining) else "Dash: Ready"
			task.wait(0.1)
		end
	end)

	local warningSerial = 0
	remotes:WaitForChild("RaidTelegraph").OnClientEvent:Connect(function(kind, first, second, third, duration)
		if typeof(kind) ~= "string" or typeof(first) ~= "Vector3" then return end
		local lifetime
		if kind == "Slam" and typeof(second) == "number" and typeof(third) == "number" then
			lifetime = third
			makeMarker(kind, first, second, nil, lifetime)
			warning.Text = "GROUND SLAM"
			warning.TextColor3 = Color3.fromRGB(255, 155, 45)
		elseif kind == "Charge" and typeof(second) == "Vector3" and typeof(third) == "number"
			and typeof(duration) == "number" then
			lifetime = duration
			makeMarker(kind, first, second, third, lifetime)
			warning.Text = "CHARGE"
			warning.TextColor3 = Color3.fromRGB(220, 105, 255)
		else
			return
		end
		warningSerial += 1
		local serial = warningSerial
		warning.Visible = true
		task.delay(math.max(0, lifetime - GameConfig.Raid.WarningFlashTime), function()
			if warningSerial == serial then
				warning.Text = "DODGE NOW!"
				warning.TextColor3 = Color3.fromRGB(255, 45, 45)
			end
		end)
		task.delay(lifetime, function()
			if warningSerial == serial then warning.Visible = false end
		end)
	end)

	local feedbackSerial = { Taken = 0, BossDamage = 0 }
	remotes:WaitForChild("RaidCombatFeedback").OnClientEvent:Connect(function(kind, amount)
		if typeof(amount) ~= "number" or amount <= 0 then return end
		local label = if kind == "Taken" then taken elseif kind == "BossDamage" then dealt else nil
		if not label then return end
		feedbackSerial[kind] += 1
		local serial = feedbackSerial[kind]
		label.Text = if kind == "Taken" then string.format("-%d", amount) else string.format("%d DAMAGE", amount)
		label.Visible = true
		task.delay(0.8, function()
			if feedbackSerial[kind] == serial then label.Visible = false end
		end)
	end)
end

return RaidController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">RaidMenuController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local GrowthConfig = require(ReplicatedStorage.Shared.GrowthConfig)
local NumberFormatter = require(ReplicatedStorage.Shared.NumberFormatter)
local UiStyle = require(script.Parent.UiStyle)
local UiText = require(script.Parent.UiText)

local RaidMenuController = {}
local gateNames = { Gate10 = "관문 10 · 일반", Gate20 = "관문 20 · 어려움", Gate30 = "관문 30 · 악몽" }

function RaidMenuController.Start(panel: Frame, stateController)
	local remotes = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local join = remotes:WaitForChild("JoinRaid")
	local growth = remotes:WaitForChild("GrowthAction")
	local state

	local title = UiStyle.Text(panel, "RaidTitle", "관문 레이드", UDim2.new(1, -20, 0, 32), UDim2.fromOffset(10, 10))
	title.TextSize = 21
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = UiStyle.Colors.Gold
	local token = UiStyle.Text(panel, "RaidTokens", "Raid Token 0", UDim2.new(1, -20, 0, 24), UDim2.fromOffset(10, 47))
	local hint = UiStyle.Text(panel, "RaidHint", "팀 승리와 유효한 공격이 있어야 관문 기록이 남습니다.",
		UDim2.new(1, -20, 0, 48), UDim2.fromOffset(10, 72))
	hint.TextSize = 12
	hint.TextColor3 = UiStyle.Colors.Muted
	local feedback = UiStyle.Text(panel, "RaidFeedback", "", UDim2.new(1, -20, 0, 25), UDim2.fromOffset(10, 121))
	feedback.TextSize = 12
	feedback.TextColor3 = UiStyle.Colors.Accent

	local gateButtons = {}
	for index, gate in ipairs(GrowthConfig.Gates) do
		local y = 155 + (index - 1) * 59
		local button = UiStyle.Button(panel, gate.Id, gateNames[gate.Id], UDim2.new(1, -20, 0, 52), UDim2.fromOffset(10, y))
		button.TextSize = 13
		gateButtons[gate.Id] = button
		button.Activated:Connect(function()
			if not state or not state.Ready then return end
			if state.Raid and state.Raid.IsParticipant then return end
			if gate.Id ~= "Gate10" and (state.BreakthroughStage or 1) < gate.Stage then
				feedback.Text = "이 관문 단계에 먼저 도달해야 합니다"
				return
			end
			join:FireServer(gate.Id)
			feedback.Text = gateNames[gate.Id] .. " 입장 요청"
		end)
	end
	local shopTitle = UiStyle.Text(panel, "TokenShop", "Raid Token 교환", UDim2.new(1, -20, 0, 25), UDim2.fromOffset(10, 342))
	shopTitle.Font = Enum.Font.GothamBold
	shopTitle.TextColor3 = UiStyle.Colors.Gold
	local shopButtons = {}
	for index, steps in ipairs(GrowthConfig.TicketSteps) do
		local button = UiStyle.Button(panel, "Exchange" .. steps, "",
			UDim2.new(1, -20, 0, 44), UDim2.fromOffset(10, 374 + (index - 1) * 49))
		button.TextSize = 13
		shopButtons[steps] = button
		button.Activated:Connect(function()
			if not state or not state.Ready then return end
			local ok, result = pcall(function()
				return growth:InvokeServer("ExchangeTicket", {
					Steps = steps,
					ExpectedTokens = state.RaidToken,
					ExpectedCount = (state.BreakthroughTickets or {})[tostring(steps)] or 0,
					RequestId = game:GetService("HttpService"):GenerateGUID(false),
				})
			end)
			feedback.Text = if ok and typeof(result) == "table"
				then (if result.Ok then string.format("+%d단계권 1장 획득", steps) else UiText.Reason(result.Reason))
				else "서버 응답을 확인하지 못했습니다"
		end)
	end
	local shopNote = UiStyle.Text(panel, "ShopNote",
		"돌파권 추가 구매: 준비 중 · 상품 ID와 가격 미설정",
		UDim2.new(1, -20, 0, 36), UDim2.fromOffset(10, 528))
	shopNote.TextSize = 12
	shopNote.TextColor3 = UiStyle.Colors.Muted

	stateController.Subscribe(function(snapshot)
		state = snapshot
		token.Text = "Raid Token  " .. NumberFormatter.Format(snapshot.RaidToken or 0)
		for _, gate in ipairs(GrowthConfig.Gates) do
			local difficulty = GameConfig.Raid.DifficultyByGate[gate.Id]
			local cleared = (snapshot.ClearedRaidGates or {})[gate.Id] == true
			local ready = (snapshot.BreakthroughStage or 1) >= gate.Stage
			gateButtons[gate.Id].Text = string.format("%s · %s\n보상 Gold %s · Token %d",
				gateNames[gate.Id], if cleared then "클리어" elseif ready then "도전 가능" else "연습 가능",
				NumberFormatter.Format(difficulty.Gold), difficulty.Tokens)
		end
		for steps, button in pairs(shopButtons) do
			button.Text = string.format("+%d단계권 · Token %d · 보유 %d장",
				steps, GrowthConfig.TokenTicketCost[steps],
				(snapshot.BreakthroughTickets or {})[tostring(steps)] or 0)
		end
	end)
end

return RaidMenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">StudioDebugController</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UiStyle = require(script.Parent.UiStyle)

local StudioDebugController = {}

function StudioDebugController.Start(panel: ScrollingFrame, stateController)
	if not RunService:IsStudio() then return end
	local remotes = ReplicatedStorage:WaitForChild("IdleRaidRemotes")
	local modeRemote = remotes:WaitForChild("StudioProfileMode")
	local grant = remotes:WaitForChild("StudioGrowthGrant")
	local receipt = remotes:WaitForChild("StudioSyntheticReceipt")
	local itemGrant = remotes:WaitForChild("StudioInventoryGrant")
	local title = UiStyle.Text(panel, "DebugTitle", "Studio 성장 테스트", UDim2.new(1, -20, 0, 32),
		UDim2.fromOffset(10, 8))
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 20
	title.TextColor3 = UiStyle.Colors.Gold
	local note = UiStyle.Text(panel, "DebugNote",
		"개발 테스트 · 실제 결제 없음. 일반 프로필과 분리됩니다.",
		UDim2.new(1, -20, 0, 45), UDim2.fromOffset(10, 42))
	note.TextSize = 12
	note.TextColor3 = UiStyle.Colors.Muted
	local feedback = UiStyle.Text(panel, "DebugFeedback", "", UDim2.new(1, -20, 0, 38),
		UDim2.fromOffset(10, 91))
	feedback.TextSize = 13
	feedback.TextColor3 = UiStyle.Colors.Accent

	local modeButton = UiStyle.Button(panel, "SwitchSandbox", "개발 체험 시작",
		UDim2.new(1, -20, 0, 44), UDim2.fromOffset(10, 136))
	local sandbox = false
	local grantButtons = {}
	modeButton.Activated:Connect(function()
		local ok, result = pcall(function() return modeRemote:InvokeServer(not sandbox) end)
		feedback.Text = if ok and result then "프로필 전환 완료" else "프로필 전환 거부됨"
	end)

	local actions = {
		{ Label = "수련력 +10K", Kind = "Power", Value = 10000 },
		{ Label = "Gold +1K", Kind = "Gold", Value = 1000 },
		{ Label = "+2 돌파권 1장", Kind = "Ticket", Value = 2 },
		{ Label = "+3 돌파권 1장", Kind = "Ticket", Value = 3 },
		{ Label = "+5 돌파권 1장", Kind = "Ticket", Value = 5 },
		{ Label = "10분 수련권 1장", Kind = "Voucher", Value = "Minutes10" },
	}
	for index, action in ipairs(actions) do
		local button = UiStyle.Button(panel, "Grant" .. index, action.Label,
			UDim2.new(1, -20, 0, 42), UDim2.fromOffset(10, 188 + (index - 1) * 47))
		table.insert(grantButtons, button)
		button.Activated:Connect(function()
			local ok, result = pcall(function() return grant:InvokeServer(action.Kind, action.Value) end)
			feedback.Text = if ok and result == true then action.Label .. " 지급됨" else "지급 거부됨"
		end)
	end
	local itemButton = UiStyle.Button(panel, "GrantTrainingSword", "Training Sword 1개",
		UDim2.new(1, -20, 0, 42), UDim2.fromOffset(10, 481))
	table.insert(grantButtons, itemButton)
	itemButton.Activated:Connect(function()
		local ok, result = pcall(function() return itemGrant:InvokeServer("TrainingSword") end)
		feedback.Text = if ok and result == true then "Training Sword 지급됨" else "아이템 지급 거부됨"
	end)
	local receiptButton = UiStyle.Button(panel, "Receipt", "모의 영수증: +2권 1장",
		UDim2.new(1, -20, 0, 44), UDim2.fromOffset(10, 528))
	table.insert(grantButtons, receiptButton)
	receiptButton.Activated:Connect(function()
		local purchaseId = "Studio:" .. HttpService:GenerateGUID(false)
		local ok, result = pcall(function() return receipt:InvokeServer(purchaseId, "Ticket2") end)
		feedback.Text = if ok and result == Enum.ProductPurchaseDecision.PurchaseGranted
			then "모의 영수증 저장 및 지급 완료" else "모의 영수증 보류"
	end)
	stateController.Subscribe(function(state)
		sandbox = state.StudioSandbox == true
		modeButton.Text = if sandbox then "일반 프로필로 돌아가기" else "개발 체험 시작 (격리 프로필)"
		for _, button in ipairs(grantButtons) do button.Visible = sandbox end
		note.Text = if sandbox then "개발 테스트 프로필 · 실제 결제 없음"
			else "일반 프로필 · 개발 지급 비활성"
	end)
	panel.CanvasSize = UDim2.fromOffset(0, 600)
end

return StudioDebugController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">UiStyle</string>
              <string name="Source"><![CDATA[local UiStyle = {}

UiStyle.Colors = {
	Panel = Color3.fromRGB(25, 35, 66),
	Surface = Color3.fromRGB(42, 58, 95),
	Accent = Color3.fromRGB(82, 210, 191),
	Gold = Color3.fromRGB(255, 205, 116),
	Text = Color3.fromRGB(247, 249, 255),
	Muted = Color3.fromRGB(182, 199, 221),
}

UiStyle.Rarities = {
	Common = Color3.fromRGB(229, 235, 244),
	Uncommon = Color3.fromRGB(116, 237, 174),
	Rare = Color3.fromRGB(115, 190, 255),
	Epic = Color3.fromRGB(199, 139, 255),
	Legendary = Color3.fromRGB(255, 197, 91),
}

function UiStyle.Corner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function UiStyle.Outline(parent: Instance, color: Color3, transparency: number)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = color
	stroke.Transparency = transparency
	stroke.Thickness = 1.5
	stroke.Parent = parent
	return stroke
end

function UiStyle.Panel(parent: Frame, radius: number)
	UiStyle.Corner(parent, radius)
	UiStyle.Outline(parent, UiStyle.Colors.Accent, 0.54)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(39, 58, 100)),
		ColorSequenceKeypoint.new(1, UiStyle.Colors.Panel),
	})
	gradient.Rotation = 90
	gradient.Parent = parent
end

function UiStyle.Text(parent: Instance, name: string, value: string, size: UDim2, position: UDim2)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = value
	label.TextColor3 = UiStyle.Colors.Text
	label.TextSize = 16
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Size = size
	label.Position = position
	label.Parent = parent
	return label
end

function UiStyle.Button(parent: Instance, name: string, value: string, size: UDim2, position: UDim2)
	local button = Instance.new("TextButton")
	button.Name = name
	button.AutoButtonColor = true
	button.BackgroundColor3 = UiStyle.Colors.Surface
	button.BorderSizePixel = 0
	button.Text = value
	button.TextColor3 = UiStyle.Colors.Text
	button.TextSize = 15
	button.Font = Enum.Font.GothamBold
	button.TextWrapped = true
	button.Size = size
	button.Position = position
	UiStyle.Corner(button, 9)
	UiStyle.Outline(button, UiStyle.Colors.Muted, 0.72)
	button.Parent = parent
	return button
end

return UiStyle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">UiText</string>
              <string name="Source"><![CDATA[-- Shared UI wording lives here so later localization can replace one table.
local UiText = {
	Loading = "데이터 연결 확인 중",
	Power = "수련력",
	Lifetime = "누적 수련력",
	Available = "사용 가능 수련력",
	Stage = "돌파 단계",
	Level = "레벨",
	Rate = "기본 수련/초",
	Multiplier = "수련 배수",
	Free = "무료 +1",
	Gate10 = "10단계 관문",
	Gate20 = "20단계 관문",
	Gate30 = "30단계 관문",
	Ready = "사용 가능",
	Reasons = {
		ProfileNotReady = "데이터 연결 확인 중",
		ReceiptSaving = "구매 기록 저장 중",
		RaidInProgress = "전투 종료 후 사용 가능",
		InsufficientPower = "수련력 부족",
		InsufficientGold = "Gold 부족",
		InsufficientToken = "Raid Token 부족",
		NoTicket = "돌파권 없음",
		NoVoucher = "수련권 없음",
		Gate10 = "10단계 관문 클리어 필요",
		Gate20 = "20단계 관문 클리어 필요",
		Gate30 = "30단계 관문 클리어 필요",
		GateRequired = "이전 관문 클리어 필요",
		MaxStage = "최고 단계",
		MaxFacility = "최고 시설 등급",
		StalePreview = "상태가 바뀌었습니다. 다시 확인하세요",
		RateLimited = "잠시 후 다시 시도하세요",
		Busy = "이전 요청 처리 중",
		InvalidRequest = "요청을 확인할 수 없습니다",
	},
}
function UiText.Reason(code)
	return UiText.Reasons[code] or "요청을 처리하지 못했습니다"
end
return UiText
]]></string>
