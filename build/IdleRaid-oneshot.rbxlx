      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">GrowthConfig</string>
          <string name="Source"><![CDATA[local GrowthConfig = {
	DataVersion = 2,
	MaxSafePower = 9007199254740991,
	MaxStage = 30,
	MaxLevel = 100,
	LevelBaseRequirement = 100,
	LevelRequirementNumerator = 13,
	LevelRequirementDenominator = 10,
	ReferenceRateAtStageOne = 10,
	StageMultiplierBase = 2,
	TargetBaseSecondsStart = 45,
	TargetBaseSecondsStep = 15,
	TargetBaseSecondsCap = 900,
	OnlineTickSeconds = 1,
	OfflineMaxSeconds = 8 * 60 * 60,
	OfflineRateNumerator = 1,
	OfflineRateDenominator = 4,
	AutosaveSeconds = 60,
	SessionLeaseSeconds = 120,
	Gates = {
		{ Id = "Gate10", Stage = 10, Difficulty = "Normal" },
		{ Id = "Gate20", Stage = 20, Difficulty = "Hard" },
		{ Id = "Gate30", Stage = 30, Difficulty = "Nightmare" },
	},
	Facilities = {
		{ Tier = 1, Numerator = 1, Denominator = 1, GoldCost = 0, RequiredGate = nil },
		{ Tier = 2, Numerator = 3, Denominator = 2, GoldCost = 120, RequiredGate = nil },
		{ Tier = 3, Numerator = 2, Denominator = 1, GoldCost = 850, RequiredGate = "Gate10" },
		{ Tier = 4, Numerator = 3, Denominator = 1, GoldCost = 6000, RequiredGate = "Gate20" },
	},
	Zones = {
		{ Id = "Field", EnemyId = "Slime", RequiredStage = 1, RewardStageCap = 9, Health = 40, GoldMin = 3, GoldMax = 7, Count = 5 },
		{ Id = "Foothill", EnemyId = "SlimeVeteran", RequiredStage = 10, RewardStageCap = 19, Health = 600, GoldMin = 16, GoldMax = 28, Count = 5 },
		{ Id = "Citadel", EnemyId = "SlimeElder", RequiredStage = 20, RewardStageCap = 30, Health = 1400, GoldMin = 80, GoldMax = 130, Count = 5 },
	},
	EnemyRewardSeconds = 2,
	Vouchers = {
		Minutes10 = { Seconds = 600, Label = "10분 수련권" },
		Minutes30 = { Seconds = 1800, Label = "30분 수련권" },
		Minutes120 = { Seconds = 7200, Label = "120분 수련권" },
	},
	TicketSteps = { 2, 3, 5 },
	TokenTicketCost = { [2] = 10, [3] = 18, [5] = 30 },
	MonetizationEnabled = false,
	Products = {
		Ticket2 = { ProductId = nil, Kind = "Ticket", Value = 2, ContractVersion = 1 },
		Ticket3 = { ProductId = nil, Kind = "Ticket", Value = 3, ContractVersion = 1 },
		Ticket5 = { ProductId = nil, Kind = "Ticket", Value = 5, ContractVersion = 1 },
		Voucher10 = { ProductId = nil, Kind = "Voucher", Value = "Minutes10", ContractVersion = 1 },
		Voucher30 = { ProductId = nil, Kind = "Voucher", Value = "Minutes30", ContractVersion = 1 },
		Voucher120 = { ProductId = nil, Kind = "Voucher", Value = "Minutes120", ContractVersion = 1 },
	},
}

return GrowthConfig
]]></string>
